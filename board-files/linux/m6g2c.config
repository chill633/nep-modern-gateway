# Merged on top of arch/arm/configs/imx_v6_v7_defconfig
#
# Everything needed to reach the root filesystem is built in, so no initramfs
# is required.

# --- Boot path -------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_ESDHC_IMX=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT2_FS=y
CONFIG_SERIAL_IMX=y
CONFIG_SERIAL_IMX_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- systemd (Debian 13 ships systemd 257: cgroup v2 only) -------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# udev handles uevents and firmware loading
# CONFIG_UEVENT_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER is not set

# --- Board peripherals --------------------------------------------------------
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_REGULATOR_ANATOP=y
CONFIG_NVMEM_IMX_OCOTP=y
CONFIG_ARM_IMX6Q_CPUFREQ=y
CONFIG_FEC=y
CONFIG_DP83848_PHY=y
CONFIG_I2C_GPIO=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_DRV_PCF85063=y
CONFIG_SPI_SPIDEV=y
# NEP's MI200E power-line modems (board-files/linux/drivers/nep-mi200e.c);
# a module named plc_mi200e_o, as gateway-plc's scripts expect
CONFIG_NEP_MI200E=m
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_SMSC_PHY=y
CONFIG_MICREL_PHY=y
CONFIG_DAVICOM_PHY=y
CONFIG_ICPLUS_PHY=y
CONFIG_REALTEK_PHY=y
CONFIG_CAN=y
CONFIG_CAN_FLEXCAN=y
CONFIG_MTD=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_GPMI_NAND=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y
CONFIG_IMX2_WDT=y
CONFIG_GPIO_WATCHDOG=y
CONFIG_GPIO_WATCHDOG_ARCH_INITCALL=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_G_SERIAL=m
CONFIG_USB_STORAGE=y
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m

# Note: do not switch off DRM here to save space. In imx_v6_v7_defconfig the
# i.MX DRM drivers are what select MFD_SYSCON, and without syscon the ANATOP
# regulators, IOMUXC GPR and cpufreq all disappear.

# --- Size / boot-time trim ---------------------------------------------------
# imx_v6_v7_defconfig builds every i.MX from the ARMv6 i.MX31 onwards plus
# graphics, sound, video and wireless: a 12 MB zImage. A smaller kernel loads
# and decompresses faster, which matters because the external watchdog only
# allows ~1.1-1.6 s between U-Boot's last kick and Linux's gpio-wdt probe.
#
# MFD_SYSCON is normally pulled in by the i.MX DRM drivers. Set it directly
# so the ANATOP regulators, IOMUXC GPR and cpufreq survive dropping DRM.
# Fast kernel decompression: it runs inside the external watchdog's window,
# and NXP's 6.12 defconfig no longer selects LZO (it would default to gzip).
CONFIG_KERNEL_LZO=y
CONFIG_MFD_SYSCON=y
# The same applies to these: the multimedia drivers pull them in, so
# dropping those would silently lose I2C (RTC bus), regulators and thermal.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_IMX=y
CONFIG_I2C_ALGOBIT=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_IMX_THERMAL=y

# ARMv7 only, i.MX6UL only
# CONFIG_ARCH_MULTI_V6 is not set
# CONFIG_SOC_IMX31 is not set
# CONFIG_SOC_IMX35 is not set
# CONFIG_SOC_IMX50 is not set
# CONFIG_SOC_IMX51 is not set
# CONFIG_SOC_IMX53 is not set
# CONFIG_SOC_IMX6Q is not set
# CONFIG_SOC_IMX6SL is not set
# CONFIG_SOC_IMX6SLL is not set
# CONFIG_SOC_IMX6SX is not set
# CONFIG_SOC_IMX7D is not set
# CONFIG_SOC_IMX7ULP is not set
# CONFIG_SOC_VF610 is not set
# CONFIG_SOC_LS1021A is not set

# No sound, video capture or Bluetooth on this build (display: see below)
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# Infrared remote control: since 6.x outside MEDIA_SUPPORT, still on in
# imx_v6_v7_defconfig. And the staging drivers.
# CONFIG_RC_CORE is not set
# CONFIG_STAGING is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set

# imx_v6_v7_defconfig turns on the lock validator (PROVE_LOCKING, which
# brings LOCKDEP and PROVE_RCU) and kprobes. They make every lock and RCU
# operation much slower, so switch them off for a production boot.
# CONFIG_PROVE_LOCKING is not set
# CONFIG_KPROBES is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# Also listed so the build's check catches a regression: these used to stay
# on (selected by PROVE_LOCKING) after it was switched off.
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_LOCKDEP is not set

# The default 64 MiB contiguous-memory pool is for graphics/video buffers.
# Without a display 16 MiB is plenty, leaving 48 MiB more RAM for Linux.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=16
# CMA rounds its size up to a whole pageblock. On Linux 6.12 a pageblock is
# 2^ARCH_FORCE_MAX_ORDER pages (from 6.4 on the option is the order itself;
# on 6.1 it was one more). imx_v6_v7_defconfig sets 13 (for big video
# buffers on larger i.MX): 32 MiB pageblocks turn 16 MiB of CMA into 32.
# The kernel default 10 gives 4 MiB; this board's framebuffer is ~0.5 MiB.
CONFIG_ARCH_FORCE_MAX_ORDER=10

# --- Wi-Fi: TP-Link TL-WN823N USB dongle -------------------------------------
# v2/v3 (2357:0109) are RTL8192EU and v1 is RTL8192CU; the in-kernel
# rtl8xxxu driver handles both (v1 needs RTL8XXXU_UNTESTED). Built as
# modules so cfg80211 can load regulatory.db and the driver its firmware
# (firmware-realtek) from the root filesystem.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
# CONFIG_RTL_CARDS is not set
# CONFIG_WLAN_VENDOR_ADMTEK is not set

# --- Wi-Fi: Atheros AR9271 USB dongles (0cf3:9271, external antenna) ---------
# ath9k_htc, firmware from Debian's open-source firmware-ath9k-htc package.
# imx_v6_v7_defconfig enables ath10k (SDIO), which this board has no use for.
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m
# CONFIG_ATH9K is not set
# CONFIG_ATH10K is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set

# --- Display: Tianma TM043NBH02, 4.3" 480x272, 16-bit RGB565 on LCDIF -------
# mxsfb (LCDIF) DRM driver + panel-simple ("panel-dpi" with the
# "data-mapping" backport in patches/linux), fbdev emulation for a text
# console on tty1, PWM backlight, and the i.MX6UL resistive touch controller.
CONFIG_DRM=y
CONFIG_DRM_MXSFB=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_IMX6UL_TSC=y
# Beeper on PWM6: input device for the console bell and tones
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PWM_BEEPER=y
# Display drivers for hardware this board doesn't have (i.MX6Q IPU, HDMI,
# Vivante GPU, LVDS/eDP panels, other touch controllers)
# CONFIG_DRM_IMX is not set
# CONFIG_IMX_IPUV3_CORE is not set
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_DRM_DW_HDMI is not set
# CONFIG_DRM_TI_TFP410 is not set
# CONFIG_DRM_PANEL_EDP is not set
# CONFIG_DRM_PANEL_LVDS is not set
# CONFIG_DRM_PANEL_SEIKO_43WVF1G is not set
# CONFIG_LCD_CLASS_DEVICE is not set
# CONFIG_BACKLIGHT_GPIO is not set
# CONFIG_TOUCHSCREEN_ADS7846 is not set
# CONFIG_TOUCHSCREEN_AD7879 is not set
# CONFIG_TOUCHSCREEN_ATMEL_MXT is not set
# CONFIG_TOUCHSCREEN_COLIBRI_VF50 is not set
# CONFIG_TOUCHSCREEN_DA9052 is not set
# CONFIG_TOUCHSCREEN_EDT_FT5X06 is not set
# CONFIG_TOUCHSCREEN_EGALAX is not set
# CONFIG_TOUCHSCREEN_GOODIX is not set
# CONFIG_TOUCHSCREEN_ILI210X is not set
# CONFIG_TOUCHSCREEN_MAX11801 is not set
# CONFIG_TOUCHSCREEN_MC13783 is not set
# CONFIG_TOUCHSCREEN_STMPE is not set
# CONFIG_TOUCHSCREEN_SX8654 is not set
# CONFIG_TOUCHSCREEN_TSC2004 is not set
# CONFIG_TOUCHSCREEN_TSC2007 is not set

# --- Noise / privacy -----------------------------------------------------------
# evbug writes every input event to the kernel log, keystrokes included. Its
# device table matches every input device, so udev loads it automatically.
# CONFIG_INPUT_EVBUG is not set
# mtdblock: NAND is used through /dev/mtd* and UBI. Its block devices only
# made udev probe the raw partitions at boot ("I/O error, dev mtdblock0":
# the start of "u-boot" holds the boot ROM's control block, which isn't
# readable with normal ECC).
# CONFIG_MTD_BLOCK is not set
