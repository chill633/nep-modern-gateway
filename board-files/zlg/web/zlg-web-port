   and PHP files. What it reads and writes stays NEP's code. Only firmware
   20230903's version is built (it knows the 800B inverters; 20210303's
   doesn't and has other files): others are skipped and the Advanced page
   says so. */
$mi = dirname($src) . '/misetup';
$chroot = str_ends_with($src, '/root/Gateway/nep') ? substr($src, 0, -strlen('/root/Gateway/nep')) : '';
$mi_ok = is_file("$mi/index.html") && is_file("$mi/js/_mi.js") && is_file("$mi/get_setting.php");
if (!$mi_ok)
	stat_add('misetup: skipped (not firmware 20230903\'s version)');
try {
if ($mi_ok) {
	$ui = "$tmp/misetup-ui";
	/* NEP links js/proxy.js and js/common.js to a variant (orig/, us_old/) */
	$real = function ($f) use ($chroot) {
		for ($i = 0; $i < 8 && is_link($f); $i++) {
			$t = readlink($f);
			$f = str_starts_with($t, '/') ? $chroot . $t : dirname($f) . "/$t";
		}
		return $f;
	};
	foreach (['css', 'fonts'] as $d)
		copy_tree("$mi/$d", "$ui/$d");
	$urls = [
		'proxy.cgi?' => '/nep/advanced/proxy?',
		'"get_file.php"' => '"/nep/advanced/files"',
		'"get_setting.php"' => '"/nep/advanced/setting"',
		'save_as_custom_conf.php?' => '/nep/advanced/savecustom?',
		'set_para_profile.php?' => '/nep/advanced/setprofile?',
		/* "Reboot Gateway" leaves setup mode here (gateway-plc starts) */
		'alert("Please refresh your browser after 20 seconds.");' => '',
		'"Are you sure to reboot Gateway?"' => '"Leave setup mode and resume the readings?"',
		'"Reboot Aborted."' => '"Cancelled."',
		'"Try to Reboot Gateway...<br>"' => '"Leaving setup mode: readings resume.<br>"',
	];
	$seen = [];
	foreach (['proxy.js', 'common.js', '_mi.js', 'bootstrap.js', 'npm.js'] as $j) {
		$f = $real("$mi/js/$j");
		is_file($f) || throw new RuntimeException("js/$j missing");
		$code = file_get_contents($f);
		foreach ($urls as $from => $to) {
			$code = str_replace($from, $to, $code, $c);
			$seen[$from] = ($seen[$from] ?? 0) + $c;
		}
		put("$ui/js/$j", $code);
	}
	foreach (['proxy.cgi?', '"get_file.php"', '"get_setting.php"', 'save_as_custom_conf.php?', 'set_para_profile.php?'] as $k)
		$seen[$k] || throw new RuntimeException("no $k in its JS");
	copy("$mi/language.json", "$ui/language.json");

	$html = file_get_contents("$mi/index.html");
	$html = str_replace('<?', "<?php echo '<?'; ?>", $html);
	$js = fn($u) => '<script type="text/javascript" src="' . $u . '"></script>';
	$edits = [
		'~<head>~' => "<head>\n    <base href=\"/misetup-ui/\">",
		/* NEP's jQuery 2.2.4 and blockUI -> the ones the other pages use */
		'~<script[^>]*src="js/jquery\.js"[^>]*>\s*</script>~' =>
			$js('/javascript/jquery/jquery.min.js') . "\n    " . $js('/zlg-web/js/jquery-migrate.min.js') .
			"\n    <script type=\"text/javascript\">$.ajaxSetup({ headers: { \"X-Csrf-Token\": \"<?php echo htmlspecialchars(\$csrf, ENT_QUOTES); ?>\" } });</script>",
		'~<script[^>]*src="js/blockUI\.js"[^>]*>\s*</script>~' => $js('/zlg-web/js/jquery.blockUI.js'),
		/* the 800B inverters' own encoding (js/zlg-mi2021.js), after NEP's code */
		'~(<script[^>]*src="js/_mi\.js"[^>]*>\s*</script>)~' => '$1' . "\n    " . $js('/zlg-web/local/zlg-mi2021.js'),
		/* the PLC password comes from the gateway (zlg-admin) */
		'~<label for="pwd">[^<]*</label>\s*<input type="password"[^>]*id="pwd"[^>]*>~' =>
			'<input type="hidden" id="pwd" name="pwd" value="gateway">',
		'~(id="btnreboot"[^>]*>)Reboot Gateway<~' => '$1Leave Setup Mode<',
		/* Bootstrap's fixed 970 px container is wider than the frame */
		'~<div class="container">~' => '<div class="container-fluid">',
		/* the settings tables' inputs have the browser's default width,
		   which pushes the 7 columns out of the frame: fit them instead */
		'~</head>~' => "<style>#myTabContent .table input[type=text] { width: 100%; min-width: 55px; " .
			"box-sizing: border-box; } #myTabContent .table td { padding: 6px; } " .
			".container-fluid { padding-left: 8px; padding-right: 8px; }</style>\n</head>",
	];
	foreach ($edits as $re => $to) {
		$html = preg_replace($re, $to, $html, 1, $c);
		$c || throw new RuntimeException("index.html: $re not found");
	}
	put("$A/views/zlg/misetup_ui.php", "<?php defined('BASEPATH') OR exit('No direct script access allowed'); ?>\n" . $html);
	stat_add('misetup: built /misetup-ui');
}
} catch (RuntimeException $e) {
	/* a version this port doesn't know: no Advanced page, rest as usual */
	rm_tree("$tmp/misetup-ui");
	@unlink("$A/views/zlg/misetup_ui.php");
	stat_add('misetup: skipped (' . $e->getMessage() . ')');
}

/* config: NEP's settings on CI3's files */
$cfg = file_get_contents("$A/config/config.php");
foreach ([
	/* a full URL, as CodeIgniter 2 had it: NEP's code redirects with
	   redirect(base_url() . "..."), which CodeIgniter 3 treats as a path
	   (adding the base again) unless it starts with http://. Built from
	   the address the browser used, so any host name or port works. */
	'base_url'		=> "((!empty(\$_SERVER['HTTPS']) && \$_SERVER['HTTPS'] !== 'off') ? 'https' : 'http') . '://' . " .
				   "(preg_match('/^[A-Za-z0-9.:\\[\\]-]+\$/', \$_SERVER['HTTP_HOST'] ?? '') ? \$_SERVER['HTTP_HOST'] : (\$_SERVER['SERVER_ADDR'] ?? 'localhost')) . '/nep/'",
	'index_page'		=> "''",	/* lighttpd rewrites /nep/x to index.php */
	'language'		=> "'english'",
	'sess_driver'		=> "'files'",
	'sess_cookie_name'	=> "'zlg_session'",
	'sess_expiration'	=> '7200',
	'sess_save_path'	=> "'/tmp/zlg-web-sess'",
	'sess_match_ip'		=> 'FALSE',
	'cookie_httponly'	=> 'TRUE',
	'log_threshold'		=> '0',
	'composer_autoload'	=> 'FALSE',
	'enable_hooks'		=> 'TRUE',
] as $k => $v)
	$cfg = ci_set($cfg, 'config', $k, $v);
put("$A/config/config.php", $cfg);

$auto = file_get_contents("$A/config/autoload.php");
$auto = ci_set($auto, 'autoload', 'libraries', "array('session')");
$auto = ci_set($auto, 'autoload', 'helper', "array('url', 'file', 'zlg_compat')");
put("$A/config/autoload.php", $auto);

$routes = file_get_contents("$A/config/routes.php");
$routes = ci_set($routes, 'route', 'default_controller', "'status'");
$routes = ci_set($routes, 'route', 'translate_uri_dashes', 'FALSE');
/* not reachable from the network: NEP's diagnostic and test pages;
   case-insensitive, as /nep/Report/SEND reaches the same method */
$routes .= "\n/* zlg-web-port: NEP's diagnostic and test pages are disabled */\n" .
	   "\$route['(?i)home/info(/.*)?'] = 'status';\n" .
	   "\$route['(?i)maildebug(/.*)?'] = 'status';\n" .
	   "\$route['(?i)report/send(/.*)?'] = 'status';\n" .
	   "\$route['(?i)home/show(/.*)?'] = 'status';\n";
put("$A/config/routes.php", $routes);

/* document root: / redirects to the status page, as NEP's index.php did */
put("$tmp/index.php", "<?php\nheader('Location: /nep/status/index/');\n");
put("$tmp/robots.txt", "User-agent: *\nDisallow: /\n");

/* sanity: every PHP file must parse under this PHP */
$bad = 0;
foreach (php_files($tmp) as $f) {
	try {
		token_get_all(file_get_contents($f), TOKEN_PARSE);
	} catch (ParseError $e) {
		$bad++;
		fwrite(STDERR, "parse error: $f:" . $e->getLine() . ': ' . $e->getMessage() . "\n");
	}
}
/* and compile (php -l): catches errors the tokenizer doesn't, such as a
   repeated attribute; the application files, CodeIgniter's are known good */
foreach (isset($opt['no-lint']) ? [] : php_files("$tmp/nep/application") as $f) {
	exec(escapeshellarg(PHP_BINARY) . ' -n -l ' . escapeshellarg($f) . ' 2>&1', $o, $rc);
	if ($rc !== 0) {
		$bad++;
		fwrite(STDERR, "compile error: $f: " . trim(implode(' ', $o)) . "\n");
	}
	$o = [];
}
$bad && fail("$bad file(s) don't parse; $out left unchanged ($tmp kept)");

ksort($stats);
foreach ($stats as $k => $n)
	note(sprintf('%5d  %s', $n, $k));

if ($check) {
	rm_tree($tmp);
	note('check only: nothing installed');
	exit(0);
}

/* swap in */
rm_tree("$out.old");
if (file_exists($out))
	rename($out, "$out.old");
rename($tmp, $out);
rm_tree("$out.old");
note("built $out");
