$stats = [];
function stat_add($k, $n = 1) { global $stats; $stats[$k] = ($stats[$k] ?? 0) + $n; }

/* ---- PHP code: calls -> zlg_ versions, via PHP's tokenizer ------------- */

const COMPAT = ['count', 'sizeof', 'sort', 'rsort', 'implode', 'join',
		'in_array', 'array_sum', 'shmop_read', 'shmop_close'];

function compat_calls(string $code): string
{
	$t = token_get_all($code);
	$n = count($t);
	$sig = function ($i, $dir) use ($t, $n) {	/* next significant token */
		for ($i += $dir; $i >= 0 && $i < $n; $i += $dir)
			if (!is_array($t[$i]) || !in_array($t[$i][0],
			    [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT]))
				return $t[$i];
		return null;
	};
	$out = '';
	for ($i = 0; $i < $n; $i++) {
		$tok = $t[$i];
		if (is_array($tok) && $tok[0] === T_STRING &&
		    in_array(strtolower($tok[1]), COMPAT, true)) {
			$next = $sig($i, 1);
			$prev = $sig($i, -1);
			$pt = is_array($prev) ? $prev[0] : $prev;
			if ($next === '(' && !in_array($pt, [T_OBJECT_OPERATOR,
			    T_NULLSAFE_OBJECT_OPERATOR, T_DOUBLE_COLON, T_FUNCTION,
			    T_NEW, T_NS_SEPARATOR], true)) {
				$f = strtolower($tok[1]);
				$f = ['sizeof' => 'count', 'join' => 'implode'][$f] ?? $f;
				$out .= "zlg_$f";
				stat_add("calls: $f()");
				continue;
			}
		}
		$out .= is_array($tok) ? $tok[1] : $tok;
	}
	return $out;
}

/* A bare word used as an array subscript, like NEP's $pos[y], was an undefined
 * constant in PHP 5/7 (a notice, then the literal string) but is a fatal Error
 * in PHP 8, so the write it guards never runs. Quote such keys. Skipped inside
 * interpolated strings, where "$a[b]" must keep the bare key, and for
 * true/false/null, which keep their meaning as array keys. php -l can't catch
 * this: it is a run-time error, not a parse error. */
function quote_bareword_keys(string $code): string
{
	$t = token_get_all($code);
	$n = count($t);
	$sig = function ($i, $dir) use ($t, $n) {	/* next significant index */
		for ($i += $dir; $i >= 0 && $i < $n; $i += $dir)
			if (!is_array($t[$i]) || !in_array($t[$i][0],
			    [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true))
				return $i;
		return -1;
	};
	$instr = false;		/* inside "..." or `...` (lone-quote tokens) */
	$heredoc = false;
	$out = '';
	for ($i = 0; $i < $n; $i++) {
		$tok = $t[$i];
		if ($tok === '"' || $tok === '`')
			$instr = !$instr;
		elseif (is_array($tok) && $tok[0] === T_START_HEREDOC)
			$heredoc = true;
		elseif (is_array($tok) && $tok[0] === T_END_HEREDOC)
			$heredoc = false;
		elseif (!$instr && !$heredoc && is_array($tok) &&
		    $tok[0] === T_STRING &&
		    !in_array(strtolower($tok[1]), ['true', 'false', 'null'], true)) {
			$pi = $sig($i, -1);
			$ni = $sig($i, 1);
			if ($pi >= 0 && $t[$pi] === '[' && $ni >= 0 && $t[$ni] === ']') {
				$bi = $sig($pi, -1);	/* token before the '[' */
				$bt = $bi >= 0 ? (is_array($t[$bi]) ? $t[$bi][0]
						  : $t[$bi]) : null;
				if (in_array($bt, [T_VARIABLE, T_STRING], true) ||
				    $t[$bi] === ']' || $t[$bi] === ')' ||
				    $t[$bi] === '}') {
					$out .= "'" . $tok[1] . "'";
					stat_add('bareword array key quoted');
					continue;
				}
			}
		}
		$out .= is_array($tok) ? $tok[1] : $tok;
	}
	return $out;
}

/* ---- views: libraries and the time display ----------------------------- */

function view_edits(string $v): string
{
	$js = function ($file) {
		return '<script type="text/javascript" src="' . $file . '"></script>';
	};
	$rules = [
		/* jQuery 1.x -> Debian's jQuery 3 + Migrate (NEP's code uses
		   APIs jQuery 3 removed, such as .live() and .size()) */
		'~<script[^>]*src="[^"]*static/js/jquery(-1\.[0-9.]+)?(\.min)?\.js"[^>]*>\s*</script>~'
			=> $js('/javascript/jquery/jquery.min.js') . "\n" .
			   $js('/zlg-web/js/jquery-migrate.min.js'),
		'~<script[^>]*src="[^"]*static/js/jquery-ui-[0-9.]+\.custom(\.min)?\.js"[^>]*>\s*</script>~'
			=> $js('/javascript/jquery-ui/jquery-ui.min.js'),
		'~<script[^>]*src="[^"]*static/js/jquery\.blockUI(\.min)?\.js"[^>]*>\s*</script>~'
			=> $js('/zlg-web/js/jquery.blockUI.js'),
		/* Highcharts 2.3.3 (2012) -> 13 (fetch-deps.sh); NEP's grid
		   theme still applies */
		'~<script[^>]*src="[^"]*static/js/jchart/js/highcharts\.js"[^>]*>\s*</script>~'
			=> $js('/zlg-web/js/highcharts.js') . "\n" .
			   $js('/zlg-web/local/zlg-highcharts.js'),
		/* simpletooltip 1.3 (2014, unmaintained) -> Debian's jQuery UI
		   tooltip, same look; titles keep their <br/> line breaks */
		'~<link[^>]*?href="[^"]*simpletooltip\.min\.css"[^>]*>\s*~' => '',
		'~<script[^>]*src="[^"]*static/js/simpletooltip\.min\.js"[^>]*>\s*</script>\s*~' => '',
		'~\.simpletooltip\(\s*(\{[^}]*\})?\s*\)~' => '.tooltip({
            classes: { "ui-tooltip": "zlg-tooltip" },
            position: { my: "center bottom-10", at: "center top" },
            content: function () {
                return $("<div>").text($(this).attr("title") || "").html()
                    .replace(/&lt;br\s*\/?&gt;/gi, "<br>");
            }
    })',
		/* Modernizr 1.7: nothing uses the class it sets */
		'~<script[^>]*src="[^"]*static/js/modernizr-transitions\.js"[^>]*>\s*</script>\s*~' => '',
		/* the status page's weather line: NEP left an empty bar and
		   commented out the call that fills it */
		'~(<div class="ui-state-highlight ui-corner-all"[^>]*>)\s*(</div>)~'
			=> '$1<span id="wt"></span>$2',
		'~/\*\s*uw\(\);\s*\*/~' => 'uw(); setInterval(uw, 1800000);',
		/* a "Weather" menu entry for the Info page (weather and map),
		   which NEP's menu doesn't link to, then this kit's settings
		   pages (app/) */
		'~(<li><a href="[^"]*info/page/"[^>]*>.*?lang_navi_Layout.*?</a></li>)~'
			=> '$1' . "\n" . '              <li><a href="<?php echo base_url();?>info/index" title=""><?php echo lang(\'lang_navi_Weather\');?></a></li>' .
			   "\n" . '              <li><a href="<?php echo base_url();?>wifi" title=""><?php echo lang(\'lang_navi_Wifi\');?></a></li>' .
			   "\n" . '              <li><a href="<?php echo base_url();?>modules" title=""><?php echo lang(\'lang_navi_Modules\');?></a></li>' .
			   "\n" . '              <li><a href="<?php echo base_url();?>advanced" title=""><?php echo lang(\'lang_navi_Advanced\');?></a></li>',
		/* the Info page's weather labels were English only; NEP's
		   language files have them (and lang_weather_map_today, below) */
		'~<h2>Weather information</h2>~' => "<h2><?php echo lang('lang_weather_map_weatherinfo');?></h2>",
		'~<td width="100px">Today</td>~' => "<td width=\"100px\"><?php echo lang('lang_weather_map_today');?></td>",
		'~<td>Low</td>~' => "<td><?php echo lang('lang_weather_map_low');?></td>",
		'~<td>High</td>~' => "<td><?php echo lang('lang_weather_map_high');?></td>",
		'~<td>Sunrise</td>~' => "<td><?php echo lang('lang_weather_map_sunrise');?></td>",
		'~<td>Sunset</td>~' => "<td><?php echo lang('lang_weather_map_sunset');?></td>",
		'~<td>Conditions</td>~' => "<td><?php echo lang('lang_weather_map_conditions');?></td>",
		/* the Info (Weather) page: this kit's source switch under the
		   weather table (views/zlg/weather_source.php) */
		'~(<div id="weather"[^>]*>.*?</table>)~s'
			=> "\$1\n<?php \$this->load->view('zlg/weather_source'); ?>",
		/* the footer's version: this build's, not NEP's (NEP's
		   /opt/config/version stays as it is for its own pages) */
		'~<\?php echo file_get_contents\(\'/opt/config/version\'\);\s*\?>~'
			=> 'Version 1.00-chill633',
		/* jQuery 1.9 changed .attr() for form state: .attr("checked")
		   and .attr("value") now return the HTML attribute, not the
		   current state, so the status page's auto-refresh never ran and
		   the settings forms read stale values */
		'~\.attr\(\s*(["\'])(checked|selected|disabled)\1\s*\)~'
			=> '.prop($1$2$1)',
		'~\.attr\(\s*(["\'])(checked|selected|disabled)\1\s*,\s*(["\'])true\3\s*\)~'
			=> '.prop($1$2$1, true)',
		'~\.attr\(\s*(["\'])(checked|selected|disabled)\1\s*,\s*(["\'])false\3\s*\)~'
			=> '.prop($1$2$1, false)',
		'~\.attr\(\s*(["\'])value\1\s*\)~' => '.val()',
		'~\.attr\(\s*(["\'])value\1\s*,\s*~' => '.val(',
		/* .live() was removed in jQuery 1.9 (and "hover" as an event) */
		'~\$\(\s*("[^"]*"|\'[^\']*\')\s*\)\.live\(\s*(["\'])hover\2\s*,~'
			=> '$(document).on("mouseenter mouseleave", $1,',
		'~\$\(\s*("[^"]*"|\'[^\']*\')\s*\)\.live\(\s*("[^"]*"|\'[^\']*\')\s*,~'
			=> '$(document).on($2, $1,',
		/* "Last updated" showed server time minus China's offset */
		'~new Date\(result\.(t|time)\*1000-28800000\)~' => 'new Date(result.$1*1000)',
		'~updatet\.toLocaleString\(\)~' => 'updatet.toLocaleString(undefined,{timeZone:"UTC"})',
	];
	foreach ($rules as $re => $to) {
		$v = preg_replace($re, $to, $v, -1, $c);
		if ($c)
			stat_add('views: ' . substr($re, 1, 50), $c);
	}
	if (str_contains($v, '"zlg-tooltip"') && !str_contains($v, 'zlg-tooltip {'))
		$v = preg_replace('~(<script[^>]*>)~', '<style>.zlg-tooltip { background: #000; color: #fff; border: 1px solid #fff; ' .
			'border-radius: 4px; font-size: 12px; padding: 4px 8px; box-shadow: none; }</style>' . "\n$1", $v, 1);
	return $v;
}

/* ---- CodeIgniter 3.1.13 on PHP 8.4 ----------------------------------- */

/* PHP 8.2+ deprecates dynamic properties, which CodeIgniter 3 (and NEP's
   classes) use everywhere; PHP 8.4 deprecates E_STRICT. */
function php84_fixes(string $code): string
{
	/* (not where it's already there: PHP refuses a repeated attribute) */
	$code = preg_replace('~^(?<!\]\n)((?:abstract\s+|final\s+)?class\s+\w+)~m',
		"#[\\AllowDynamicProperties]\n\$1", $code, -1, $c);
	if ($c)
		stat_add('classes: #[AllowDynamicProperties]', $c);
	$code = str_replace(["E_STRICT\t\t=>\t'Runtime Notice'", ' & ~E_STRICT'],
			    ["2048\t\t=>\t'Runtime Notice'", ''], $code, $c);
	if ($c)
		stat_add('E_STRICT removed', $c);
	return $code;
}

/* ---- build ----------------------------------------------------------- */

function copy_tree($from, $to)
{
	@mkdir($to, 0755, true);
	foreach (scandir($from) as $f) {
		if ($f === '.' || $f === '..' || str_starts_with($f, '._') ||
		    str_ends_with($f, '~'))
			continue;
		is_dir("$from/$f") ? copy_tree("$from/$f", "$to/$f")
				   : copy("$from/$f", "$to/$f");
	}
}

function rm_tree($d)
{
	if (!file_exists($d) && !is_link($d))
		return;
	if (is_dir($d) && !is_link($d)) {
		foreach (scandir($d) as $f)
			if ($f !== '.' && $f !== '..')
				rm_tree("$d/$f");
		rmdir($d);
	} else {
		unlink($d);
	}
}

function put($file, $data)
{
	@mkdir(dirname($file), 0755, true);
	file_put_contents($file, $data) !== false || fail("cannot write $file");
}

function php_files($dir)
{
	$it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($dir,
		FilesystemIterator::SKIP_DOTS));
	foreach ($it as $f)
		if ($f->isFile() && str_ends_with($f->getFilename(), '.php') &&
		    !str_starts_with($f->getFilename(), '._'))
			yield $f->getPathname();
}

/* set $config['key'] / $route['key'] in a CI3 config file */
function ci_set(string $php, string $var, string $key, string $val): string
{
	$re = '~^\$' . $var . '\[\'' . preg_quote($key, '~') . '\'\]\s*=.*?;\s*$~m';
	$line = "\${$var}['$key'] = $val;";
	if (preg_match($re, $php))
		return preg_replace($re, addcslashes($line, '\\$'), $php, 1);
	return rtrim($php) . "\n$line\n";
}

$tmp = "$out.new";
rm_tree($tmp);
$nep = "$tmp/nep";

/* CodeIgniter 3 */
copy_tree("$deps/ci3/system", "$nep/system");
foreach (php_files("$nep/system") as $f) {
	$code = file_get_contents($f);
	$new = php84_fixes($code);
	if ($new !== $code)
		put($f, $new);
}
$index = file_get_contents("$deps/ci3/index.php");
$index = str_replace(
	"define('ENVIRONMENT', isset(\$_SERVER['CI_ENV']) ? \$_SERVER['CI_ENV'] : 'development');",
	"define('ENVIRONMENT', isset(\$_SERVER['CI_ENV']) ? \$_SERVER['CI_ENV'] : 'production');",
	$index, $c);
$c || fail('CI3 index.php: ENVIRONMENT line not found');
put("$nep/index.php", php84_fixes($index));

/* application: CI3 skeleton first, then NEP's own parts */
$A = "$nep/application";
copy_tree("$deps/ci3/application/config", "$A/config");
foreach (['cache', 'logs', 'core', 'hooks', 'third_party', 'helpers'] as $d)
	@mkdir("$A/$d", 0755, true);
copy_tree("$app/language", "$A/language");
copy_tree("$app/views", "$A/views");
copy_tree("$deps/ci3/application/views/errors", "$A/views/errors");	/* CI3's */

foreach (['controllers', 'models', 'libraries'] as $d) {
	@mkdir("$A/$d", 0755, true);
	foreach (scandir("$app/$d") as $f) {
		if (!str_ends_with($f, '.php') || str_starts_with($f, '._'))
			continue;
		/* NEP's native-session class: CI3's session replaces it */
		if ($d === 'libraries' && $f === 'Session.php') {
			stat_add('dropped: libraries/Session.php');
			continue;
		}
		/* encrypted with php_screw (a PHP 5-only extension): unusable */
		if (str_starts_with(file_get_contents("$app/$d/$f", false, null, 0, 16), "\tHANDENG")) {
			stat_add("dropped (php_screw-encrypted): $d/$f");
			continue;
		}
		/* NEP's Google Static Maps library (no API key: a broken image) */
		if ($d === 'libraries' && $f === 'Googlemaps.php') {
			copy("$web/Googlemaps.php", "$A/libraries/Googlemaps.php");
			stat_add('replaced: libraries/Googlemaps.php (OpenStreetMap)');
			continue;
		}
		$name = ucfirst($f);
		/* a controller whose class doesn't match its file name never
		   worked (NEP's status2.php is a stale copy of status.php) */
		if ($d === 'controllers' &&
		    !preg_match('~^\s*class\s+' . preg_quote(pathinfo($name, PATHINFO_FILENAME), '~') . '\b~mi',
				file_get_contents("$app/$d/$f"))) {
			stat_add("dropped (class doesn't match the file name): $d/$f");
			continue;
		}
		if ($name !== $f)
			stat_add("renamed $d/*.php to Ucfirst");
		put("$A/$d/$name", file_get_contents("$app/$d/$f"));
	}
}
/* language files: the "Weather" menu entry and the Info page's "Today",
   which NEP's files don't have; added after related entries, keeping each
   file's line endings */
$newlang = [
	'english'  => ['lang_navi_Weather' => 'Weather', 'lang_navi_Wifi' => 'Wi-Fi', 'lang_navi_Modules' => 'Modules', 'lang_navi_Advanced' => 'Advanced', 'lang_weather_map_today' => 'Today'],
	'japanese' => ['lang_navi_Weather' => '天気', 'lang_navi_Wifi' => 'Wi-Fi', 'lang_navi_Modules' => 'モジュール', 'lang_navi_Advanced' => '詳細設定', 'lang_weather_map_today' => '今日'],
	'chinese'  => ['lang_navi_Weather' => '天气', 'lang_navi_Wifi' => 'Wi-Fi', 'lang_navi_Modules' => '模块', 'lang_navi_Advanced' => '高级设置', 'lang_weather_map_today' => '今天'],
];
$after = ['lang_navi_Weather' => 'lang_navi_Layout', 'lang_navi_Wifi' => 'lang_navi_Weather', 'lang_navi_Modules' => 'lang_navi_Wifi',
	  'lang_navi_Advanced' => 'lang_navi_Modules',
	  'lang_weather_map_today' => 'lang_weather_map_weatherinfo'];
foreach ($newlang as $l => $keys) {
	$f = "$A/language/$l/nep_lang.php";
	if (!is_file($f))
		continue;
	$code = file_get_contents($f);
	foreach ($keys as $k => $text) {
		if (str_contains($code, "'$k'"))
			continue;
		$re = '~^([ \t]*)\$lang\[\'' . $after[$k] . '\'\][^\n]*?(\r?\n)~m';
		$code = preg_replace_callback($re, fn($m) => $m[0] . $m[1] . "\$lang['$k'] = \"$text\";" . $m[2],
					      $code, 1, $c);
		$c ? stat_add("language: $k") : fail("language/$l: no {$after[$k]} line");
	}
	put($f, $code);
}

copy("$web/zlg_compat_helper.php", "$A/helpers/zlg_compat_helper.php");
copy("$web/zlg_log_hook.php", "$A/hooks/Zlg_log_hook.php");
put("$A/config/hooks.php", "<?php\ndefined('BASEPATH') OR exit('No direct script access allowed');\n" .
	"\$hook['pre_system'] = array('class' => 'Zlg_log_hook', 'function' => 'install',\n" .
	"\t'filename' => 'Zlg_log_hook.php', 'filepath' => 'hooks');\n");

/* NEP's code: compat calls (controllers, models, libraries, views) */
foreach (['controllers', 'models', 'libraries', 'views'] as $d) {
	foreach (php_files("$A/$d") as $f) {
		if (str_contains($f, '/views/errors/'))
			continue;
		$code = file_get_contents($f);
		$new = quote_bareword_keys(compat_calls($code));
		if ($d === 'views')
			$new = view_edits($new);
		else
			$new = php84_fixes($new);
		if ($new !== $code)
			put($f, $new);
	}
}

/* this kit's settings pages (controllers, libraries, views/zlg), after the
   conversion of NEP's code above: they are written for PHP 8 already */
foreach (['controllers', 'libraries', 'views'] as $d) {
	if (!is_dir("$web/app/$d"))
		continue;
	copy_tree("$web/app/$d", "$A/$d");
	stat_add("kit pages: $d");
}

