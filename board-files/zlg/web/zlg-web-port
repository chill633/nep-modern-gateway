#!/usr/bin/php8.4
<?php
/*
 * zlg-web-port: build the PHP 8 / CodeIgniter 3 version of NEP's web
 * interface from the copy of ZLG's system in /srv/zlg.
 *
 *   zlg-web-port [--src DIR] [--deps DIR] [--web DIR] [--out DIR] [--check]
 *
 *   --src   NEP's app:            /srv/zlg/root/Gateway/nep
 *   --deps  fetched by fetch-deps.sh: /usr/local/share/zlg/web/deps
 *   --web   this kit's web files: /usr/local/share/zlg/web
 *   --out   new document root:   /srv/zlg/www   (built next to it, then swapped)
 *   --check only report what would change
 *   --no-lint skip the php -l pass (for testing under emulation)
 *
 * NEP's code is not part of this kit: it is converted on the board from the
 * copy in /srv/zlg, and the original stays untouched. Re-run after
 * zlg-import or when this script changes; the result is the same each time.
 *
 * What changes, and why:
 *  - CodeIgniter 2.1.3 (doesn't run on PHP 8) -> 3.1.13 with CI3's own
 *    config files, carrying over NEP's settings (routes, autoload, language)
 *  - controllers and models renamed to Ucfirst.php (CI3 needs it)
 *  - NEP's own Session library dropped: CI3's session (files driver) has the
 *    same userdata()/set_userdata() calls
 *  - count(), sort(), implode(), in_array(), array_sum(), shmop_read() in
 *    NEP's code -> zlg_ versions with PHP 5 behaviour for null/false
 *    arguments
 *  - a bare word as an array subscript (NEP's $pos[y], which broke saving
 *    the panel layout) -> a quoted key, as PHP 5 treated it
 *  - jQuery 1.8.2 / jQuery UI 1.9.0 / blockUI 2.39 -> Debian's jQuery 3 and
 *    jQuery UI 1.13 (patched by apt), jQuery Migrate, blockUI 2.70;
 *    Highcharts 2.3.3 -> 13; simpletooltip -> jQuery UI's tooltip;
 *    Modernizr dropped
 *  - "Last updated": no China offset (see zlg-chroot)
 *  - home/info, home/show (a database demo), maildebug and
 *    report/send are
 *    not reachable
 *  - files encrypted with php_screw (controllers/proxy.php) can't run on
 *    PHP 8 and are left out
 *  - this kit's settings pages (app/: Wi-Fi, Modules, Advanced), linked in
 *    the menu after Weather; NEP's own copies (/root/Gateway/wifi, ...)
 *    aren't served. Advanced shows NEP's MI Setup page (misetup, built into
 *    /misetup-ui) with its proxy.cgi and PHP files replaced by the kit's
 */

$opt = getopt('', ['src:', 'deps:', 'web:', 'out:', 'check', 'no-lint']);
$src  = rtrim($opt['src']  ?? '/srv/zlg/root/Gateway/nep', '/');
$web  = rtrim($opt['web']  ?? '/usr/local/share/zlg/web', '/');
$deps = rtrim($opt['deps'] ?? "$web/deps", '/');
$out  = rtrim($opt['out']  ?? '/srv/zlg/www', '/');
$check = isset($opt['check']);

function fail($m) { fwrite(STDERR, "zlg-web-port: $m\n"); exit(1); }
function note($m) { echo $m, "\n"; }

foreach (["$src/application/controllers", "$deps/ci3/system/core/CodeIgniter.php",
	  "$deps/ci3/index.php", "$web/zlg_compat_helper.php"] as $need)
	file_exists($need) || fail("missing $need");

