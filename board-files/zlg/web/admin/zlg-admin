#!/usr/bin/php8.4
<?php
/*
 * zlg-admin: the privileged side of the web interface's settings pages
 * (Wi-Fi, Modules, Advanced). Runs as root outside /srv/zlg; the pages (PHP in
 * zlg-web-fpm, www-data, chrooted) talk to it over a Unix socket:
 *
 *   zlg-admin.socket  /run/zlg/admin.sock (inside /srv/zlg: /m6g2c/run/admin.sock),
 *                     group www-data; one zlg-admin@.service per connection,
 *                     one JSON request line in, one JSON reply line out
 *
 * Viewing needs no login; every change needs a token from auth.login (the
 * settings password, default "gateway"). Requests are checked here, not in
 * the pages.
 *
 *   zlg-admin                   serve one request on stdin/stdout (the socket)
 *   zlg-admin --wifi-apply-job  apply staged Wi-Fi settings (run by systemd-run)
 *   zlg-admin --wifi-guard      at boot: undo a Wi-Fi change that was never
 *                               confirmed (power lost while it was tested)
 *   zlg-admin --reset-password  set the settings password back to "gateway"
 *   zlg-admin --set-mi-password the PLC password for the Advanced page (stdin)
 *   zlg-admin --mi-report-job   read all modules, write the grid report (systemd-run)
 */

const STATE = '/var/lib/zlg-admin';	/* password, previous Wi-Fi files */
const RUN = '/run/zlg-admin';		/* tokens, Wi-Fi apply status */
const WPA_CONF = '/etc/wpa_supplicant/wpa_supplicant-wlan0.conf';
const NET_CONF = '/etc/systemd/network/25-wireless.network';
const IFACE = 'wlan0';
const GW = '/srv/zlg/root/Gateway';
const DEFAULT_PASSWORD = 'gateway';
const TOKEN_TTL = 7200;			/* seconds since the last use */
const WIFI_WAIT = 90;			/* seconds to connect before rolling back */
const SBIN = '/usr/sbin';

umask(077);
@mkdir(STATE, 0700, true);
@mkdir(RUN, 0700, true);

/* ---- small helpers ----------------------------------------------------- */

class Fail extends Exception {}
function fail(string $m) { throw new Fail($m); }

function run(array $argv, ?int &$rc = null): string
{
	$cmd = implode(' ', array_map('escapeshellarg', $argv)) . ' 2>/dev/null';
	exec($cmd, $out, $rc);
	return implode("\n", $out);
}

/* write a file atomically (temporary file in the same directory, rename) */
function put_atomic(string $file, string $data, int $mode): void
{
	$tmp = $file . '.zlg-new';
	if (file_put_contents($tmp, $data) === false)
		fail("cannot write $file");
	chmod($tmp, $mode);
	$fh = fopen($tmp, 'r');
	fsync($fh);
	fclose($fh);
	rename($tmp, $file) || fail("cannot replace $file");
}

function with_lock(string $name, callable $f)
{
	$fh = fopen(RUN . "/$name.lock", 'c');
	flock($fh, LOCK_EX);
	try {
		return $f();
	} finally {
		flock($fh, LOCK_UN);
		fclose($fh);
	}
}

function json_file(string $f): array
{
	$d = is_file($f) ? json_decode((string)file_get_contents($f), true) : null;
	return is_array($d) ? $d : [];
}

/* ---- password and tokens ------------------------------------------------ */

function password_file(): string { return STATE . '/password'; }

function password_ok(string $pw): bool
{
	$h = is_file(password_file()) ? trim((string)file_get_contents(password_file())) : '';
	if ($h === '')
		return hash_equals(DEFAULT_PASSWORD, $pw);
	return password_verify($pw, $h);
}

function set_password(string $pw): void
{
	put_atomic(password_file(), password_hash($pw, PASSWORD_DEFAULT) . "\n", 0600);
}

/* tokens are kept as SHA-256 hashes with the time of their last use */
function tokens_update(callable $f)
{
	return with_lock('tokens', function () use ($f) {
		$file = RUN . '/tokens.json';
		$t = json_file($file);
		$now = time();
		$t = array_filter($t, fn($last) => $now - $last < TOKEN_TTL);
		$r = $f($t, $now);
		put_atomic($file, json_encode($t), 0600);
		return $r;
	});
}

function token_valid(?string $token): bool
{
	if (!is_string($token) || !preg_match('/^[0-9a-f]{64}$/', $token))
		return false;
	$h = hash('sha256', $token);
	return tokens_update(function (&$t, $now) use ($h) {
		if (!isset($t[$h]))
			return false;
		$t[$h] = $now;
		return true;
	});
}

function need_token(array $req): void
{
	token_valid($req['token'] ?? null) || fail('login needed');
}

/* failed logins: at most 5 in 5 minutes */
function login_allowed(): bool
{
	$f = json_file(RUN . '/login-failures.json');
	return count(array_filter($f, fn($t) => time() - $t < 300)) < 5;
}

function login_failed(): void
{
	with_lock('failures', function () {
		$file = RUN . '/login-failures.json';
		$f = array_values(array_filter(json_file($file), fn($t) => time() - $t < 300));
		$f[] = time();
		put_atomic($file, json_encode($f), 0600);
	});
	sleep(1);
}

function op_auth_login(array $req): array
{
	login_allowed() || fail('too many wrong passwords; try again in 5 minutes');
	if (!password_ok((string)($req['password'] ?? ''))) {
		login_failed();
		fail('wrong password');
	}
	$token = bin2hex(random_bytes(32));
	$h = hash('sha256', $token);
	tokens_update(function (&$t, $now) use ($h) { $t[$h] = $now; });
	return ['token' => $token];
}

function op_auth_check(array $req): array
{
	return ['valid' => token_valid($req['token'] ?? null)];
}

function op_auth_logout(array $req): array
{
	$token = (string)($req['token'] ?? '');
	$h = hash('sha256', $token);
	tokens_update(function (&$t) use ($h) { unset($t[$h]); });
	return [];
}

function op_auth_passwd(array $req): array
{
	need_token($req);
	login_allowed() || fail('too many wrong passwords; try again in 5 minutes');
	if (!password_ok((string)($req['old'] ?? ''))) {
		login_failed();
		fail('the current password is wrong');
	}
	$new = (string)($req['new'] ?? '');
	if (strlen($new) < 8 || strlen($new) > 128 || preg_match('/[\x00-\x1f\x7f]/', $new))
		fail('the new password needs 8 to 128 characters');
	set_password($new);
	/* everyone else is logged out */
	$keep = hash('sha256', (string)$req['token']);
	tokens_update(function (&$t) use ($keep) { $t = array_intersect_key($t, [$keep => 1]); });
	return [];
}

/* ---- Wi-Fi: reading -------------------------------------------------------- */

function kv(string $text, string $sep = '='): array
{
	$r = [];
	foreach (explode("\n", $text) as $l)
		if (($p = strpos($l, $sep)) !== false)
			$r[trim(substr($l, 0, $p))] = trim(substr($l, $p + 1));
	return $r;
}

/* wpa_supplicant writes an SSID as "text" or as hex */
function wpa_ssid(string $v): string
{
	if (strlen($v) >= 2 && $v[0] === '"' && str_ends_with($v, '"'))
		return substr($v, 1, -1);
	return ctype_xdigit($v) && strlen($v) % 2 === 0 ? hex2bin($v) : $v;
}

/* the networks in the wpa_supplicant file: [ssid, security, lines] */
function wpa_parse(string $conf): array
{
	$head = [];
	$nets = [];
	$cur = null;
	foreach (explode("\n", $conf) as $l) {
		$t = trim($l);
		if ($cur === null && preg_match('/^network\s*=\s*\{$/', $t)) {
			$cur = [];
			continue;
		}
		if ($cur !== null) {
			if ($t === '}') {
				$nets[] = $cur;
				$cur = null;
			} elseif ($t !== '' && $t[0] !== '#' && ($p = strpos($t, '=')) !== false) {
				$cur[substr($t, 0, $p)] = substr($t, $p + 1);
			}
			continue;
		}
		if ($t !== '' && $t[0] !== '#' && ($p = strpos($t, '=')) !== false)
			$head[substr($t, 0, $p)] = substr($t, $p + 1);
	}
	$out = [];
	foreach ($nets as $n) {
		$km = $n['key_mgmt'] ?? 'WPA-PSK';
		$sec = str_contains($km, 'SAE') ? 'wpa3' : ($km === 'NONE' ? 'open' : 'wpa2');
		$out[] = ['ssid' => wpa_ssid($n['ssid'] ?? ''), 'security' => $sec, 'lines' => $n];
	}
	return ['head' => $head, 'networks' => $out];
}

function net_parse(string $conf): array
{
	$r = ['mode' => 'dhcp', 'address' => '', 'gateway' => '', 'dns' => []];
	foreach (explode("\n", $conf) as $l) {
		$l = trim($l);
		if (preg_match('/^DHCP\s*=\s*(\S+)/i', $l, $m))
			$r['mode'] = in_array(strtolower($m[1]), ['yes', 'ipv4', 'true'], true) ? 'dhcp' : 'static';
		elseif (preg_match('/^Address\s*=\s*(\S+)/i', $l, $m))
			$r['address'] = $m[1];
		elseif (preg_match('/^Gateway\s*=\s*(\S+)/i', $l, $m))
			$r['gateway'] = $m[1];
		elseif (preg_match('/^DNS\s*=\s*(.+)$/i', $l, $m))
			$r['dns'] = array_merge($r['dns'], preg_split('/\s+/', trim($m[1])));
	}
	if ($r['address'] !== '' && !preg_match('/^DHCP\s*=\s*(yes|ipv4|true)/mi', $conf))
		$r['mode'] = 'static';
	return $r;
}

function wifi_link(): array
{
	$s = kv(run([SBIN . '/wpa_cli', '-i', IFACE, 'status']));
	$link = run([SBIN . '/iw', 'dev', IFACE, 'link']);
	$r = [
		'state' => $s['wpa_state'] ?? '',
		'ssid' => isset($s['ssid']) ? stripcslashes($s['ssid']) : '',
		'bssid' => $s['bssid'] ?? '',
		'freq' => isset($s['freq']) ? (int)$s['freq'] : null,
		'ip' => $s['ip_address'] ?? '',
		'key_mgmt' => $s['key_mgmt'] ?? '',
		'signal' => preg_match('/signal:\s*(-?\d+)/', $link, $m) ? (int)$m[1] : null,
		'rx_rate' => preg_match('/rx bitrate:\s*([\d.]+ \S+)/', $link, $m) ? $m[1] : '',
		'tx_rate' => preg_match('/tx bitrate:\s*([\d.]+ \S+)/', $link, $m) ? $m[1] : '',
	];
	return $r;
}

function op_wifi_status(array $req): array
{
	$present = is_dir('/sys/class/net/' . IFACE);
	$driver = $present ? basename((string)@readlink('/sys/class/net/' . IFACE . '/device/driver')) : '';
	$wpa = wpa_parse(is_file(WPA_CONF) ? (string)file_get_contents(WPA_CONF) : '');
	$net = net_parse(is_file(NET_CONF) ? (string)file_get_contents(NET_CONF) : '');
	$nets = array_map(fn($n) => ['ssid' => $n['ssid'], 'security' => $n['security']], $wpa['networks']);
	$route = run([SBIN . '/ip', '-4', 'route', 'show', 'default', 'dev', IFACE]);
	return [
		'present' => $present,
		'driver' => $driver,
		'link' => $present ? wifi_link() : null,
		'prefix' => $present && preg_match('~inet [\d.]+/(\d+)~', run([SBIN . '/ip', '-4', 'addr', 'show', 'dev', IFACE]), $m) ? (int)$m[1] : null,
		'route' => preg_match('/default via ([\d.]+)/', $route, $m) ? $m[1] : '',
		'country' => $wpa['head']['country'] ?? '',
		'networks' => $nets,
		'ipv4' => $net,
		'apply' => json_file(RUN . '/wifi-apply.json'),
	];
}

function op_wifi_scan(array $req): array
{
	need_token($req);
	is_dir('/sys/class/net/' . IFACE) || fail('no Wi-Fi adapter');
	run([SBIN . '/wpa_cli', '-i', IFACE, 'scan']);
	sleep(5);
	$res = run([SBIN . '/wpa_cli', '-i', IFACE, 'scan_results']);
	$best = [];
	foreach (array_slice(explode("\n", $res), 1) as $l) {
		$f = explode("\t", $l);
		if (count($f) < 5)
			continue;
		$ssid = stripcslashes($f[4]);
		if ($ssid === '' || str_starts_with($ssid, "\0"))
			continue;
		$flags = $f[3];
		$sec = str_contains($flags, 'SAE') && !str_contains($flags, 'PSK') ? 'wpa3'
			: (str_contains($flags, 'PSK') ? 'wpa2' : (str_contains($flags, 'WEP') ? 'wep' : 'open'));
		$sig = (int)$f[2];
		if (!isset($best[$ssid]) || $sig > $best[$ssid]['signal'])
			$best[$ssid] = ['ssid' => $ssid, 'signal' => $sig, 'freq' => (int)$f[1],
					'security' => $sec, 'aps' => ($best[$ssid]['aps'] ?? 0) + 1];
		else
			$best[$ssid]['aps']++;
	}
	usort($best, fn($a, $b) => $b['signal'] <=> $a['signal']);
	return ['networks' => array_values($best)];
}

/* ---- Wi-Fi: applying ------------------------------------------------------- */

function ipv4_ok(string $ip): bool
{
	return filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) !== false;
}

function in_subnet(string $ip, string $net, int $prefix): bool
{
	$mask = $prefix === 0 ? 0 : (~0 << (32 - $prefix)) & 0xffffffff;
	return (ip2long($ip) & $mask) === (ip2long($net) & $mask);
}

function wpa_quote_ssid(string $ssid): string
{
	if (preg_match('/^[\x20-\x7e]*$/', $ssid) && !str_contains($ssid, '"'))
		return '"' . $ssid . '"';
	return bin2hex($ssid);
}

function op_wifi_apply(array $req): array
{
	need_token($req);
	$ssid = (string)($req['ssid'] ?? '');
	$sec = (string)($req['security'] ?? '');
	$pass = (string)($req['passphrase'] ?? '');
	$mode = (string)($req['ipv4'] ?? 'dhcp');

	(strlen($ssid) >= 1 && strlen($ssid) <= 32 && !preg_match('/[\x00-\x1f]/', $ssid))
		|| fail('the network name needs 1 to 32 characters');
	in_array($sec, ['open', 'wpa2', 'wpa3'], true) || fail('unknown security type');
	in_array($mode, ['dhcp', 'static'], true) || fail('unknown address mode');

	$cur = wpa_parse(is_file(WPA_CONF) ? (string)file_get_contents(WPA_CONF) : '');
	$country = $cur['head']['country'] ?? 'US';
	preg_match('/^[A-Z]{2}$/', $country) || $country = 'US';

	$net = ["\tssid=" . wpa_quote_ssid($ssid)];
	if ($sec !== 'open') {
		if ($pass === '') {
			/* keep the stored key: only for the same network and security */
			$old = null;
			foreach ($cur['networks'] as $n)
				if ($n['ssid'] === $ssid && $n['security'] === $sec)
					$old = $n['lines'];
			$key = $sec === 'wpa2' ? 'psk' : 'sae_password';
			($old !== null && isset($old[$key]))
				|| fail('enter the Wi-Fi password (no stored one for this network)');
			$keyline = "\t$key=" . $old[$key];
		} else {
			(strlen($pass) >= 8 && strlen($pass) <= 63 && preg_match('/^[\x20-\x7e]+$/', $pass))
				|| fail('the Wi-Fi password needs 8 to 63 characters (letters, digits, punctuation, spaces)');
			/* WPA2: only the derived key is stored, as wpa_passphrase does */
			$keyline = $sec === 'wpa2'
				? "\tpsk=" . hash_pbkdf2('sha1', $pass, $ssid, 4096, 64)
				: "\tsae_password=\"" . $pass . '"';
		}
		$net[] = $sec === 'wpa2' ? "\tkey_mgmt=WPA-PSK" : "\tkey_mgmt=SAE";
		$net[] = $keyline;
		if ($sec === 'wpa3')
			$net[] = "\tieee80211w=2";
	} else {
		$net[] = "\tkey_mgmt=NONE";
	}
	$wpa = "ctrl_interface=/run/wpa_supplicant\nupdate_config=1\ncountry=$country\n\n" .
	       "network={\n" . implode("\n", $net) . "\n}\n";

	$netconf = "[Match]\nName=wlan*\n\n[Network]\n";
	if ($mode === 'dhcp') {
		$netconf .= "DHCP=yes\n";
	} else {
		$addr = (string)($req['address'] ?? '');
		$gw = (string)($req['gateway'] ?? '');
		$dns = array_values(array_filter(preg_split('/[\s,]+/', (string)($req['dns'] ?? ''))));
		preg_match('~^([\d.]+)/(\d{1,2})$~', $addr, $m) && ipv4_ok($m[1]) && $m[2] >= 8 && $m[2] <= 30
			|| fail('the address must look like 192.168.1.50/24');
		ipv4_ok($gw) || fail('the gateway (router) address is not valid');
		in_subnet($gw, $m[1], (int)$m[2]) || fail('the gateway is not in the address\'s network');
		$gw !== $m[1] || fail('the address and the gateway are the same');
		count($dns) <= 3 || fail('at most 3 DNS servers');
		foreach ($dns as $d)
			ipv4_ok($d) || fail("DNS server $d is not a valid address");
		$netconf .= "Address=$addr\nGateway=$gw\n";
		foreach ($dns ?: [$gw] as $d)
			$netconf .= "DNS=$d\n";
	}

	return with_lock('wifi', function () use ($wpa, $netconf, $ssid) {
		$st = json_file(RUN . '/wifi-apply.json');
		if (in_array($st['state'] ?? '', ['starting', 'applying', 'rolling_back'], true) &&
		    time() - ($st['time'] ?? 0) < 600)
			fail('a Wi-Fi change is already in progress');
		@mkdir(RUN . '/wifi-new', 0700);
		put_atomic(RUN . '/wifi-new/wpa.conf', $wpa, 0600);
		put_atomic(RUN . '/wifi-new/net.conf', $netconf, 0644);
		$id = bin2hex(random_bytes(6));
		wifi_status(['id' => $id, 'state' => 'starting', 'ssid' => $ssid]);
		run(['/usr/bin/systemd-run', '--quiet', '--collect', '--unit=zlg-wifi-apply-' . $id,
		     '--property=Type=exec', '/usr/local/sbin/zlg-admin', '--wifi-apply-job'], $rc);
		if ($rc !== 0) {
			wifi_status(['id' => $id, 'state' => 'failed', 'ssid' => $ssid,
				     'message' => 'could not start the change']);
			fail('could not start the change');
		}
		return ['id' => $id, 'wait' => WIFI_WAIT];
	});
}

function wifi_status(array $s): void
{
	$s['time'] = time();
	put_atomic(RUN . '/wifi-apply.json', json_encode($s), 0600);
}

function wifi_restart(): void
{
	run(['/usr/bin/systemctl', 'restart', 'wpa_supplicant@' . IFACE . '.service']);
	run(['/usr/bin/networkctl', 'reload']);
	run(['/usr/bin/networkctl', 'reconfigure', IFACE]);
}

/* connected: associated, an IPv4 address, and the router answers */
function wifi_connected(): ?array
{
	$l = wifi_link();
	if ($l['state'] !== 'COMPLETED' || $l['ip'] === '')
		return null;
	$route = run([SBIN . '/ip', '-4', 'route', 'show', 'default', 'dev', IFACE]);
	if (!preg_match('/default via ([\d.]+)/', $route, $m))
		return null;
	run(['/usr/bin/ping', '-c', '1', '-W', '2', '-I', IFACE, $m[1]], $rc);
	return $rc === 0 ? $l : null;
}

function wifi_wait(int $secs): ?array
{
	$end = time() + $secs;
	sleep(5);	/* let the restart take the old link down first */
	do {
		if ($l = wifi_connected())
			return $l;
		sleep(3);
	} while (time() < $end);
	return null;
}

function wifi_apply_job(): void
{
	$st = json_file(RUN . '/wifi-apply.json');
	$id = $st['id'] ?? '';
	$ssid = $st['ssid'] ?? '';
	$prev = STATE . '/wifi-prev';
	@mkdir($prev, 0700);
	copy(WPA_CONF, "$prev/wpa.conf") || fail('cannot back up ' . WPA_CONF);
	copy(NET_CONF, "$prev/net.conf") || fail('cannot back up ' . NET_CONF);
	/* if the power goes before this is confirmed, --wifi-guard puts the
	   previous files back at the next boot */
	touch(STATE . '/wifi-pending');
	run(['/usr/bin/sync']);

	wifi_status(['id' => $id, 'state' => 'applying', 'ssid' => $ssid]);
	put_atomic(WPA_CONF, (string)file_get_contents(RUN . '/wifi-new/wpa.conf'), 0600);
	put_atomic(NET_CONF, (string)file_get_contents(RUN . '/wifi-new/net.conf'), 0644);
	wifi_restart();
	$l = wifi_wait(WIFI_WAIT);
	if ($l) {
		@unlink(STATE . '/wifi-pending');
		run(['/usr/bin/sync']);
		wifi_status(['id' => $id, 'state' => 'ok', 'ssid' => $ssid, 'ip' => $l['ip'],
			     'message' => "connected to {$l['ssid']}"]);
		syslog(LOG_NOTICE, "zlg-admin: Wi-Fi changed to \"$ssid\", connected as {$l['ip']}");
		return;
	}

	syslog(LOG_WARNING, "zlg-admin: Wi-Fi \"$ssid\" did not connect in " . WIFI_WAIT . " s; restoring the previous settings");
	wifi_status(['id' => $id, 'state' => 'rolling_back', 'ssid' => $ssid]);
	put_atomic(WPA_CONF, (string)file_get_contents("$prev/wpa.conf"), 0600);
	put_atomic(NET_CONF, (string)file_get_contents("$prev/net.conf"), 0644);
	@unlink(STATE . '/wifi-pending');
	run(['/usr/bin/sync']);
	wifi_restart();
	$l = wifi_wait(WIFI_WAIT);
	wifi_status(['id' => $id, 'state' => $l ? 'rolled_back' : 'rollback_failed', 'ssid' => $ssid,
		     'ip' => $l['ip'] ?? '',
		     'message' => "couldn't connect to \"$ssid\" within " . WIFI_WAIT . ' seconds; ' .
			($l ? 'the previous settings are back' : 'the previous settings are back but not connected yet')]);
}

function wifi_guard(): void
{
	$prev = STATE . '/wifi-prev';
	if (!is_file(STATE . '/wifi-pending'))
		return;
	if (is_file("$prev/wpa.conf") && is_file("$prev/net.conf")) {
		put_atomic(WPA_CONF, (string)file_get_contents("$prev/wpa.conf"), 0600);
		put_atomic(NET_CONF, (string)file_get_contents("$prev/net.conf"), 0644);
		echo "zlg-admin: an unconfirmed Wi-Fi change was undone\n";
	}
	@unlink(STATE . '/wifi-pending');
	run(['/usr/bin/sync']);
}

/* ---- Modules: the inverter and meter IDs (plc_id.conf) ---------------------- */

/* where NEP's files are; ZLG_ADMIN_GW points elsewhere for tests (root, from
   the command line only: the socket's service has a fixed environment) */
function gw(): string { return getenv('ZLG_ADMIN_GW') ?: GW; }

/* plc_id.conf: InverterN=0x<hex>, N from 0 (the gateway, FFFF) to 255 */
function plcid_parse(string $conf): array
{
	$slots = [];
	foreach (explode("\n", $conf) as $l)
		if (preg_match('/^Inverter(\d+)=(.*)$/', trim($l), $m))
			$slots[(int)$m[1]] = trim($m[2]);
	ksort($slots);
	return $slots;
}

function plcid_value(string $v): string	/* "0x33AB..." -> "33AB...", "0x" -> "" */
{
	$v = strtoupper(preg_replace('/^0X/i', '', trim($v)));
	return ltrim($v, '0');
}

function op_modules_get(array $req): array
{
	$f = gw() . '/plc_id.conf';
	is_file($f) || fail('plc_id.conf is missing');
	$slots = plcid_parse((string)file_get_contents($f));
	$ids = [];
	foreach ($slots as $n => $v)
		if ($n > 0)
			$ids[$n] = plcid_value($v);
	while ($ids && end($ids) === '')
		array_pop($ids);
	$eng = @parse_ini_file(gw() . '/engineer.cfg', false, INI_SCANNER_RAW) ?: [];
	return ['ids' => array_values($ids), 'slots' => max(0, count($slots) - 1),
		'phase_3' => ($eng['phase_3'] ?? '0') === '1',
		'modcount' => trim((string)@file_get_contents(gw() . '/modcount'))];
}

$after_reply = null;	/* run once the reply is sent (a restart) */

function op_modules_set(array $req): array
{
	global $after_reply;
	need_token($req);
	$f = gw() . '/plc_id.conf';
	is_file($f) || fail('plc_id.conf is missing');
	$conf = (string)file_get_contents($f);
	$slots = plcid_parse($conf);
	isset($slots[0]) || fail('plc_id.conf has no Inverter0 line');
	$max = count($slots) - 1;

	$in = $req['ids'] ?? null;
	is_array($in) || fail('no IDs sent');
	$ids = [];
	foreach (array_values($in) as $i => $v) {
		$v = strtoupper(trim((string)$v));
		$n = $i + 1;
		if ($v === '') {
			$ids[] = '';
			continue;
		}
		/* a whole serial number (21508-0005F123-U) or its ID part */
		if (preg_match('/^\w{5}-([0-9A-F]{8})-\w$/', $v, $m))
			$v = $m[1];
		preg_match('/^[0-9A-F]{1,8}$/', $v)
			|| fail("module $n: an ID is 1 to 8 hex digits (0-9, A-F), or a serial number like 21508-0005F123-U");
		$v = ltrim($v, '0');
		$v !== '' || fail("module $n: the ID can't be 0");
		$ids[] = $v;
	}
	while ($ids && end($ids) === '')
		array_pop($ids);
	foreach ($ids as $i => $v)
		$v !== '' || fail('module ' . ($i + 1) . ' is empty: the list must not have gaps');
	count($ids) <= $max || fail("at most $max modules");
	$dup = array_diff_assoc($ids, array_unique($ids));
	if ($dup) {
		$v = reset($dup);
		fail("ID $v is in the list twice (modules " . implode(' and ',
			array_map(fn($k) => $k + 1, array_keys($ids, $v))) . ')');
	}

	$lines = ['Inverter0=' . $slots[0]];
	for ($n = 1; $n <= $max; $n++)
		$lines[] = "Inverter$n=0x" . ($ids[$n - 1] ?? '');
	$new = implode("\n", $lines) . (str_ends_with($conf, "\n") ? "\n" : '');
	if ($new === $conf)
		return ['changed' => false];

	$bak = STATE . '/modules';
	@mkdir($bak, 0700);
	copy($f, "$bak/plc_id.conf." . date('Ymd-His')) || fail('cannot back up plc_id.conf');
	$old = glob("$bak/plc_id.conf.*");
	sort($old);
	foreach (array_slice($old, 0, -10) as $o)
		unlink($o);
	put_atomic($f, $new, fileperms($f) & 0777);
	syslog(LOG_NOTICE, 'zlg-admin: ' . gw() . '/plc_id.conf saved, ' . count($ids) . ' modules' .
	       (gw() === GW ? '; restarting the gateway software' : ''));
	/* NEP's programs read the list when they start: restart them the way
	   NEP's own "reboot" does (zlg-restart.path restarts zlg.target) */
	if (gw() === GW)
		$after_reply = function () {
			sleep(1);
			touch('/run/zlg/restart');
		};
	return ['changed' => true, 'count' => count($ids)];
}

/* ---- Advanced: inverter grid settings (NEP's misetup, 20230903) ------------
 *
 * NEP's own MI Setup page (HTML/JS from the 20230903 firmware, built into
 * /srv/zlg/www/misetup-ui by zlg-web-port) talks to these instead of NEP's
 * proxy.cgi, with the same replies. Reading needs no login; "setup mode"
 * stops gateway-plc (the power-line modem serves one program) and starts it
 * again after 10 idle minutes. Writing needs a login and ZLG_MI_WRITES=1 in
 * /etc/default/zlg. The PLC password plc_set needs is kept on the board
 * (STATE/mi-password, root only; zlg-admin --set-mi-password), so the page
 * doesn't ask for it.
 */

const MI_IDLE = 600;		/* seconds of setup mode without a request */

function mi_sn(): string
{
	$sn = @file_get_contents(gw() . '/sn');
	preg_match('/^[A-Za-z_]+=(\S+)/m', (string)$sn, $m) || fail('the gateway serial number file is missing');
	return $m[1];
}

function mi_pwd(): string
{
	$p = trim((string)@file_get_contents(STATE . '/mi-password'));
	$p !== '' || fail('the PLC password is not set on this gateway (sudo zlg-admin --set-mi-password)');
	return $p;
}

function mi_plc_pid(): string
{
	$pid = trim(run(['/usr/bin/pidof', '-s', 'gateway-plc']));
	return ctype_digit($pid) ? $pid : '';
}

function mi_modcnt(): int
{
	$n = 0;
	foreach (plcid_parse((string)@file_get_contents(gw() . '/plc_id.conf')) as $k => $v)
		if ($k > 0 && plcid_value($v) !== '')
			$n++;
	return $n;
}

function mi_ini(string $file): array
{
	$r = [];
	foreach (explode("\n", (string)@file_get_contents($file)) as $l)
		if (($p = strpos($l, '=')) !== false)
			$r[trim(substr($l, 0, $p))] = trim(substr($l, $p + 1));
	return $r;
}

function mi_chroot(array $argv, int $timeout = 30): string
{
	return run(array_merge(['/usr/bin/timeout', (string)$timeout, '/usr/local/sbin/zlg-chroot',
				'run', '/root/Gateway'], $argv));
}

/* setup mode: gateway-plc stopped, back on its own after MI_IDLE seconds */
function mi_keep_setup(): void
{
	run(['/usr/bin/systemctl', 'stop', 'zlg-mi-resume-*.timer']);
	run(['/usr/bin/systemd-run', '--quiet', '--collect', '--unit=zlg-mi-resume-' . bin2hex(random_bytes(4)),
	     '--on-active=' . MI_IDLE, '/usr/bin/systemctl', 'start', 'zlg-plc.service']);
}

function op_mi_init(array $req): array
{
	$plc = mi_ini(gw() . '/plc.conf');
	$eng = mi_ini(gw() . '/engineer.cfg');
	$ver = json_decode(trim(mi_chroot(['./plc_set', '-j', '-v'], 15)), true);
	$up = (int)(float)@file_get_contents('/proc/uptime');
	$gwinfo = ['serial_number' => mi_sn(), 'modcnt' => (string)mi_modcnt()];
	foreach (['', '_2', '_3', '_4', '_5', '_6', '_14'] as $sfx)
		$gwinfo["ac_v_gain$sfx"] = $plc["AC_V_Gain$sfx"] ?? '';
	$gwinfo['plcset_debug'] = $eng['plcset_debug'] ?? '0';
	$gwinfo['reconn_time_offset'] = $plc['reconn_time_offset'] ?? '0';
	$pid = mi_plc_pid();
	return ['reply' => ['type' => '1',
		'Proxy' => ['Ver' => 'zlg-admin', 'Date' => date('Y-m-d H:i:s', filemtime(__FILE__))],
		'Setup' => is_array($ver) ? $ver : ['Ver' => '?', 'Date' => ''],
		'Gateway' => $gwinfo,
		'plc' => ['pid' => $pid, 'pids' => $pid],
		'sys' => ['uptime' => sprintf('%d days %02d:%02d', intdiv($up, 86400), intdiv($up % 86400, 3600),
					     intdiv($up % 3600, 60)), 'ref' => '']]];
}

function op_mi_find(array $req): array
{
	$pid = mi_plc_pid();
	if ($pid === '')
		mi_keep_setup();
	return ['reply' => ['cnt' => $pid === '' ? '0' : $pid, 'pid' => $pid]];
}

function mi_report_busy(): void
{
	$st = json_file(RUN . '/mi-report.json');
	if (in_array($st['state'] ?? '', ['starting', 'reading'], true) && time() - ($st['time'] ?? 0) < 300)
		return_reply(['type' => '0', 'data' => 'A grid report is being made; try again when it is done.']);
}

function op_mi_setup(array $req): array
{
	mi_report_busy();
	$pid = mi_plc_pid();
	run(['/usr/bin/systemctl', 'stop', 'zlg-plc.service']);
	mi_keep_setup();
	syslog(LOG_NOTICE, 'zlg-admin: MI setup mode: gateway-plc stopped (back after ' . MI_IDLE . ' idle seconds)');
	return ['reply' => ['type' => '1', 'data' => "stop plc :$pid."]];
}

function op_mi_leave(array $req): array
{
	mi_report_busy();
	run(['/usr/bin/systemctl', 'stop', 'zlg-mi-resume-*.timer']);
	run(['/usr/bin/systemctl', 'start', 'zlg-plc.service']);
	syslog(LOG_NOTICE, 'zlg-admin: MI setup mode ended: gateway-plc started');
	return ['reply' => ['type' => '1', 'data' => 'gateway-plc started; readings resume.']];
}

function mi_writes_on(): bool
{
	$d = mi_ini('/etc/default/zlg');
	return ($d['ZLG_MI_WRITES'] ?? '0') === '1';
}

/* one command to one module: mod 1 (read: the command's settings all zero)
   or mod 2 (write) */
function op_mi_cmd(array $req): array
{
	mi_report_busy();
	$write = ($req['op'] ?? '') === 'mi.write';
	$ind = (string)($req['ind'] ?? '');
	$cmd = strtolower((string)($req['cmd'] ?? ''));
	(ctype_digit($ind) && (int)$ind >= 1 && (int)$ind <= mi_modcnt())
		|| fail('no such module');
	preg_match('/^000[12][0-9a-f]{64}$/', $cmd) || fail('invalid command');
	$isread = preg_match('/^000[12]0{64}$/', $cmd) === 1;
	if ($write && !$isread) {
		need_token($req);
		/* firmware 20210303's MI Setup encodes the 800B's settings wrongly;
		   only 20230903's page is built (zlg-web-port), and only it writes */
		$fw = mi_ini(gw() . '/gateway.cfg');
		(int)($fw['major'] ?? 0) >= 20230903 || return_reply(['type' => '0', 'data' =>
			'Writing settings needs NEP firmware 20230903 or later on this gateway.']);
		mi_writes_on() || return_reply(['type' => '0', 'data' =>
			'Writing settings is switched off on this gateway (ZLG_MI_WRITES in /etc/default/zlg).']);
	} elseif (!$isread) {
		fail('invalid command');
	}
	if (mi_plc_pid() !== '')
		return ['reply' => ['type' => '0', 'data' => 'Enter Setup Mode First.']];
	mi_keep_setup();
	$out = trim(mi_chroot(['./plc_set', '-j', '-p', mi_pwd(), '-i', $ind, '-c', $cmd]));
	if ($write && !$isread) {
		$line = date('Y-m-d H:i:s') . " module $ind cmd $cmd reply $out\n";
		file_put_contents(STATE . '/mi-writes.log', $line, FILE_APPEND);
		syslog(LOG_NOTICE, "zlg-admin: MI settings written to module $ind: $cmd");
	}
	$r = json_decode($out, true);
	return ['reply' => is_array($r) ? $r : ['type' => '0', 'data' => 'no answer from plc_set']];
}

/* one read, as plc_set's reply data ("62 37 ..."), or null: no answer
   (an all-zero reply, final) or no valid reply after $tries attempts */
function mi_read(int $ind, string $cmd, int $tries = 3): ?string
{
	for ($i = 0; $i < $tries; $i++) {
		$r = json_decode(trim(mi_chroot(['./plc_set', '-j', '-p', mi_pwd(), '-i', (string)$ind,
						  '-c', $cmd . str_repeat('0', 64)])), true);
		if (is_array($r) && ($r['type'] ?? '') === '10' && isset($r['data']))
			return preg_match('/^(00 ){44}$/', trim($r['data']) . ' ') ? null : trim($r['data']);
	}
	return null;
}

/* ---- the grid report (Advanced page) --------------------------------------
 * A background job (systemd-run): every module's basic and extended
 * settings, decoded as MI Setup does (mi-report.php), as a CSV and a PDF in
 * one .tgz. Readings stop while it runs; gateway-plc is started again after
 * if it was running before. */

const MI_REPORT_LIB = '/usr/local/share/zlg/web/admin/mi-report.php';

function mi_report_status(array $s): void
{
	$s['time'] = time();
	put_atomic(RUN . '/mi-report.json', json_encode($s), 0600);
}

function op_mi_report_start(array $req): array
{
	need_token($req);
	mi_pwd();
	return with_lock('mireport', function () {
		$st = json_file(RUN . '/mi-report.json');
		if (in_array($st['state'] ?? '', ['starting', 'reading'], true) && time() - ($st['time'] ?? 0) < 300)
			fail('a grid report is already being made');
		$id = bin2hex(random_bytes(6));
		mi_report_status(['id' => $id, 'state' => 'starting', 'done' => 0, 'total' => mi_modcnt()]);
		run(['/usr/bin/systemd-run', '--quiet', '--collect', '--unit=zlg-mi-report-' . $id,
		     '--property=Type=exec', '/usr/local/sbin/zlg-admin', '--mi-report-job'], $rc);
		if ($rc !== 0) {
			mi_report_status(['id' => $id, 'state' => 'failed', 'message' => 'could not start the report']);
			fail('could not start the report');
		}
		return ['id' => $id];
	});
}

function op_mi_report_status(array $req): array
{
	$st = json_file(RUN . '/mi-report.json');
	unset($st['file']);
	return ['report' => $st];
}

function op_mi_report_get(array $req): array
{
	need_token($req);
	$st = json_file(RUN . '/mi-report.json');
	(($st['state'] ?? '') === 'done' && ($st['id'] ?? '') === (string)($req['id'] ?? '') &&
	 is_file($st['file'] ?? '')) || fail('no such report');
	return ['name' => $st['name'], 'data' => base64_encode((string)file_get_contents($st['file']))];
}

function mi_report_job(): void
{
	require MI_REPORT_LIB;
	$tz = @readlink('/etc/localtime');
	if ($tz && preg_match('~zoneinfo/(.+)$~', $tz, $m))
		@date_default_timezone_set($m[1]);
	$st = json_file(RUN . '/mi-report.json');
	$id = $st['id'] ?? '';
	$ids = [];
	foreach (plcid_parse((string)file_get_contents(gw() . '/plc_id.conf')) as $n => $v)
		if ($n > 0 && plcid_value($v) !== '')
			$ids[$n] = str_pad(plcid_value($v), 8, '0', STR_PAD_LEFT);
	$total = count($ids);
	$was_running = mi_plc_pid() !== '';
	$raw = [];
	try {
		mi_report_status(['id' => $id, 'state' => 'reading', 'done' => 0, 'total' => $total]);
		run(['/usr/bin/systemctl', 'stop', 'zlg-plc.service']);
		syslog(LOG_NOTICE, "zlg-admin: grid report: reading $total modules (gateway-plc stopped)");
		$done = 0;
		foreach ($ids as $n => $hex) {
			mi_keep_setup();
			if (str_starts_with($hex, 'FF'))	/* a meter, not an inverter */
				$raw[$n] = ['skip' => 'meter'];
			else
				$raw[$n] = ($b = mi_read($n, '0001')) === null ? ['basic' => null, 'ext' => null]
					: ['basic' => $b, 'ext' => mi_read($n, '0002')];
			mi_report_status(['id' => $id, 'state' => 'reading', 'done' => ++$done, 'total' => $total]);
		}
	} finally {
		if ($was_running) {
			run(['/usr/bin/systemctl', 'stop', 'zlg-mi-resume-*.timer']);
			run(['/usr/bin/systemctl', 'start', 'zlg-plc.service']);
		} else {
			mi_keep_setup();
		}
	}

	$plc = mi_ini(gw() . '/plc.conf');
	$gains = [];
	foreach (['', '_2', '_3', '_4', '_5', '_6', '_14'] as $sfx)
		$gains[] = is_numeric($plc["AC_V_Gain$sfx"] ?? '') ? (float)$plc["AC_V_Gain$sfx"] : 0.0;
	$offset = is_numeric($plc['reconn_time_offset'] ?? '') ? (float)$plc['reconn_time_offset'] : 0.0;

	/* the nominal grid frequency the limits are offsets from: what the
	   inverters measure (their minute log, data/<n>/min.dat: time, power,
	   DC V, AC V, AC A, Hz, ...), else the grid code's, else unknown */
	$freq = null;
	$fsrc = '';
	foreach ($ids as $n => $hex) {
		$l = mi_last_line(gw() . "/data/$n/min.dat");
		$f = preg_split('/\s+/', $l);
		if (count($f) >= 7 && is_numeric($f[6]) && $f[6] >= 45 && $f[6] <= 65 &&
		    ($t = strtotime("$f[0] $f[1]")) && abs(time() - $t) < 86400) {
			$freq = abs($f[6] - 50) < abs($f[6] - 60) ? 50.0 : 60.0;
			$fsrc = "measured {$f[6]} Hz (module $n, $f[0] $f[1])";
			break;
		}
	}
	if ($freq === null) {
		$grids = [];
		foreach ($raw as $r)
			if ($b = mi_bytes($r['basic'] ?? null))
				$grids[] = $b[14];
		$byGrid = [5 => 50, 6 => 60, 7 => 60, 8 => 50, 12 => 50, 13 => 50, 14 => 50, 15 => 50, 16 => 60, 17 => 50];
		$g = $grids ? array_search(max(array_count_values($grids)), array_count_values($grids)) : 0;
		if (isset($byGrid[$g])) {
			$freq = (float)$byGrid[$g];
			$fsrc = "from grid code $g";
		}
	}
	$mods = [];
	$ok = $ext_ok = 0;
	foreach ($ids as $n => $hex) {
		$r = $raw[$n];
		$model = mi_model($hex, $gains);
		$b = mi_bytes($r['basic'] ?? null);
		$e = mi_bytes($r['ext'] ?? null);
		$basic = $b ? mi_decode_basic($b, $model, $freq ?? 0.0, $offset) : [];
		$ok += $b ? 1 : 0;
		$ext_ok += $e ? 1 : 0;
		$mods[] = [
			'n' => $n, 'id' => $hex,
			'basic_state' => isset($r['skip']) ? 'not read' : ($b ? 'ok' : 'no answer'),
			'ext_state' => isset($r['skip']) ? 'meter' : ($e ? 'ok' : 'no answer'),
			'basic' => $basic,
			'old' => $b && in_array($basic['grid'] ?? 0, [6, 7], true) ? mi_decode_old($b, $model, $freq ?? 0.0) : [],
			'ext' => $e ? mi_decode_ext($e) : [],
			'raw_basic' => $r['basic'] ?? null, 'raw_ext' => $r['ext'] ?? null,
		];
	}
	$cfg = mi_ini(gw() . '/gateway.cfg');
	$meta = ['time' => date('Y-m-d H:i T'), 'host' => gethostname(),
		 'firmware' => ($cfg['major'] ?? '?') . ' minor ' . ($cfg['minor'] ?? '?'),
		 'freq' => $freq === null ? null : (int)$freq, 'freq_src' => $fsrc, 'read_ok' => $ok, 'ext_ok' => $ext_ok];
	$base = 'grid-report-' . preg_replace('/[^A-Za-z0-9-]/', '', gethostname()) . '-' . date('Ymd-Hi');
	$dir = RUN . '/mi-report-work';
	run(['/usr/bin/rm', '-rf', $dir]);
	mkdir($dir, 0700);
	file_put_contents("$dir/$base.csv", mi_report_csv($meta, $mods));
	file_put_contents("$dir/$base.pdf", mi_report_pdf($meta, $mods));
	chmod("$dir/$base.csv", 0644);
	chmod("$dir/$base.pdf", 0644);
	$tgz = RUN . '/mi-report.tgz';
	@unlink($tgz);
	run(['/usr/bin/tar', 'czf', $tgz, '-C', $dir, "$base.csv", "$base.pdf"], $rc);
	run(['/usr/bin/rm', '-rf', $dir]);
	$rc === 0 || fail('could not pack the report');
	syslog(LOG_NOTICE, "zlg-admin: grid report $base made ($ok of $total modules answered)");
	mi_report_status(['id' => $id, 'state' => 'done', 'name' => "$base.tgz", 'file' => $tgz,
			  'done' => $total, 'total' => $total, 'read_ok' => $ok,
			  'message' => "$ok of $total modules answered"]);
}

function mi_last_line(string $f): string
{
	$h = @fopen($f, 'r');
	if (!$h)
		return '';
	fseek($h, max(0, filesize($f) - 512));
	$l = array_values(array_filter(explode("\n", (string)stream_get_contents($h)), 'strlen'));
	fclose($h);
	return trim(end($l) ?: '');
}

class Reply extends Exception { public $reply; }
function return_reply(array $r) { $e = new Reply(); $e->reply = $r; throw $e; }

function op_mi_list(array $req): array
{
	$slots = plcid_parse((string)@file_get_contents(gw() . '/plc_id.conf'));
	$data = [];
	for ($n = 0; $n < 256; $n++) {
		$v = plcid_value($slots[$n] ?? '');
		$data[] = ['id' => (string)$n, 'data' => $v === '' ? '0' : $v];
	}
	return ['reply' => ['type' => '1', 'modnum' => (string)mi_modcnt(), 'data' => $data]];
}

function mi_dir(): string { return gw() . '/misetup'; }

function mi_name_ok(string $n): bool
{
	return preg_match('/^[A-Za-z0-9][A-Za-z0-9_.-]{0,39}$/', $n) && !str_contains($n, '..');
}

function op_mi_save_custom(array $req): array
{
	need_token($req);
	$name = (string)($req['name'] ?? '');
	mi_name_ok($name) || fail('a profile name is 1 to 40 letters, digits, ".", "_" or "-"');
	$data = $req['data'] ?? null;
	(is_array($data) && count($data) > 0 && count($data) <= 150) || fail('no settings sent');
	$out = '';
	foreach ($data as $k => $v) {
		$v = trim((string)$v);
		(preg_match('/^[a-z0-9_]{1,40}$/', (string)$k) && preg_match('/^-?\d{0,6}(\.\d{1,6})?$/', $v))
			|| fail("invalid setting $k");
		$out .= "$k=$v\n";
	}
	$dir = mi_dir() . '/setting/custom';
	is_dir($dir) || fail('no custom profile folder');
	put_atomic("$dir/$name.conf", $out, 0644);
	syslog(LOG_NOTICE, "zlg-admin: MI custom profile $name saved");
	return ['reply' => 'ok'];
}

function op_mi_set_profile(array $req): array
{
	need_token($req);
	$name = (string)($req['name'] ?? '');
	($name === '0' || mi_name_ok($name)) || fail('invalid profile name');
	put_atomic(mi_dir() . '/para_profile.txt', $name, 0644);
	return ['reply' => 'ok'];
}

/* ---- the request loop -------------------------------------------------- */

const OPS = [
	'auth.login' => 'op_auth_login',
	'auth.check' => 'op_auth_check',
	'auth.logout' => 'op_auth_logout',
	'auth.passwd' => 'op_auth_passwd',
	'wifi.status' => 'op_wifi_status',
	'wifi.scan' => 'op_wifi_scan',
	'wifi.apply' => 'op_wifi_apply',
	'modules.get' => 'op_modules_get',
	'modules.set' => 'op_modules_set',
	'mi.init' => 'op_mi_init',
	'mi.find' => 'op_mi_find',
	'mi.setup' => 'op_mi_setup',
	'mi.leave' => 'op_mi_leave',
	'mi.read' => 'op_mi_cmd',
	'mi.write' => 'op_mi_cmd',
	'mi.list' => 'op_mi_list',
	'mi.save_custom' => 'op_mi_save_custom',
	'mi.set_profile' => 'op_mi_set_profile',
	'mi.report_start' => 'op_mi_report_start',
	'mi.report_status' => 'op_mi_report_status',
	'mi.report_get' => 'op_mi_report_get',
];

function serve(): void
{
	stream_set_timeout(STDIN, 10);
	$line = fgets(STDIN, 65536);
	try {
		$req = is_string($line) ? json_decode($line, true) : null;
		is_array($req) || fail('bad request');
		$op = $req['op'] ?? '';
		isset(OPS[$op]) || fail('unknown request');
		$r = ['ok' => true] + (OPS[$op])($req);
	} catch (Reply $e) {
		$r = ['ok' => true, 'reply' => $e->reply];
	} catch (Fail $e) {
		$r = ['ok' => false, 'error' => $e->getMessage()];
	} catch (Throwable $e) {
		syslog(LOG_ERR, 'zlg-admin: ' . $e->getMessage());
		$r = ['ok' => false, 'error' => 'internal error'];
	}
	fwrite(STDOUT, json_encode($r, JSON_INVALID_UTF8_SUBSTITUTE) . "\n");
	fflush(STDOUT);
	global $after_reply;
	if ($after_reply) {
		fclose(STDOUT);
		($after_reply)();
	}
}

openlog('zlg-admin', LOG_PID, LOG_DAEMON);
try {
	switch ($argv[1] ?? '') {
	case '':
		serve();
		break;
	case '--wifi-apply-job':
		try {
			wifi_apply_job();
		} catch (Throwable $e) {
			/* nothing was changed if the backup failed; otherwise the
			   guard's rollback runs now rather than at the next boot */
			wifi_guard();
			wifi_restart();
			$st = json_file(RUN . '/wifi-apply.json');
			wifi_status(['id' => $st['id'] ?? '', 'state' => 'failed', 'ssid' => $st['ssid'] ?? '',
				     'message' => $e->getMessage()]);
			throw $e;
		}
		break;
	case '--mi-report-job':
		try {
			mi_report_job();
		} catch (Throwable $e) {
			$st = json_file(RUN . '/mi-report.json');
			mi_report_status(['id' => $st['id'] ?? '', 'state' => 'failed', 'message' => $e->getMessage()]);
			throw $e;
		}
		break;
	case '--wifi-guard':
		wifi_guard();
		break;
	case '--set-mi-password':
		$p = trim((string)fgets(STDIN, 256));
		preg_match('/^[0-9A-Za-z]{1,16}$/', $p) || fail('1 to 16 letters or digits');
		put_atomic(STATE . '/mi-password', "$p\n", 0600);
		echo "Saved.\n";
		break;
	case '--reset-password':
		@unlink(password_file());
		echo "The settings password is \"" . DEFAULT_PASSWORD . "\" again.\n";
		break;
	default:
		fwrite(STDERR, "usage: zlg-admin [--wifi-apply-job | --wifi-guard | --reset-password]\n");
		exit(2);
	}
} catch (Fail $e) {
	fwrite(STDERR, 'zlg-admin: ' . $e->getMessage() . "\n");
	exit(1);
}
