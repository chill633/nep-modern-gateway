[Unit]
Description=ZLG gateway: PHP 8.4 for the web interface (php-fpm in /srv/zlg)
BindsTo=zlg-chroot.service
After=zlg-chroot.service
PartOf=zlg.target
ConditionPathExists=/srv/zlg/www/nep/index.php

[Service]
Type=notify
# NEP's code expects the clock on local time labelled UTC (zlg-time.so)
Environment=LD_PRELOAD=/usr/local/lib/zlg/zlg-time.so
RuntimeDirectory=zlg-web
RuntimeDirectoryPreserve=restart
ExecStartPre=/usr/bin/install -d -o www-data -g www-data -m 700 /srv/zlg/tmp/zlg-web-sess
ExecStart=/usr/sbin/php-fpm8.4 --nodaemonize --fpm-config /etc/zlg/php-fpm.conf \
	-d opcache.memory_consumption=16 -d opcache.interned_strings_buffer=4 -d opcache.jit=off
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=zlg.target
