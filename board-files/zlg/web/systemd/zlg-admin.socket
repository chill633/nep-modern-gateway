[Unit]
Description=ZLG gateway: settings helper for the web interface (socket)

[Socket]
# the host's /run/zlg is /m6g2c/run inside /srv/zlg (zlg-chroot), where
# the web interface's PHP (www-data) connects
ListenStream=/run/zlg/admin.sock
SocketUser=root
SocketGroup=www-data
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=8

[Install]
WantedBy=sockets.target
