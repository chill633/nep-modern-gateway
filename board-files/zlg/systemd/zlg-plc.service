[Unit]
Description=ZLG gateway: power-line communication with the inverters (gateway-plc)
BindsTo=zlg-chroot.service
After=zlg-chroot.service
PartOf=zlg.target

[Service]
# skipped (not failed) when this version of ZLG's software doesn't have it;
# checked inside /srv/zlg, where its links point
ExecCondition=/usr/local/sbin/zlg-chroot run / /bin/sh -c "test -e /root/Gateway/gateway-plc"
ExecStart=/usr/local/sbin/zlg-chroot run /root/Gateway ./gateway-plc
Restart=always
RestartSec=10
# NEP's programs log to files or /dev/null themselves
StandardOutput=null


[Install]
WantedBy=zlg.target
