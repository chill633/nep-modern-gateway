[Unit]
Description=ZLG gateway: web interface (ZLG's lighttpd + PHP 5, port 80)
BindsTo=zlg-chroot.service
After=zlg-chroot.service
PartOf=zlg.target

[Service]
# skipped (not failed) when this version of ZLG's software doesn't have it;
# checked inside /srv/zlg, where its links point
ExecCondition=/usr/local/sbin/zlg-chroot run / /bin/sh -c "test -e /opt/httpd/sbin/lighttpd"
ExecStart=/usr/local/sbin/zlg-chroot run /opt/httpd ./sbin/lighttpd -D -f /opt/httpd/conf/lighttpd.conf
Restart=always
RestartSec=10
# NEP's programs log to files or /dev/null themselves
StandardOutput=journal


[Install]
WantedBy=zlg.target
