[Unit]
Description=ZLG gateway: scheduled jobs (ZLG's crontab, BusyBox crond)
BindsTo=zlg-chroot.service
After=zlg-chroot.service
PartOf=zlg.target

[Service]
# skipped (not failed) when this version of ZLG's software doesn't have it;
# checked inside /srv/zlg, where its links point
ExecCondition=/usr/local/sbin/zlg-chroot run / /bin/sh -c "test -e /usr/sbin/crond"
ExecStart=/usr/local/sbin/zlg-chroot run / /usr/sbin/crond -f -l 8 -c /var/spool/cron/crontabs
Restart=always
RestartSec=10
# NEP's programs log to files or /dev/null themselves
StandardOutput=journal


[Install]
WantedBy=zlg.target
