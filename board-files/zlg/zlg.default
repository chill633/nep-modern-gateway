# Settings for ZLG's gateway software in /srv/zlg (zlg-chroot, zlg-*.service)

# ZLG's programs see the clock shifted to local time (zlg-time.so), as on
# ZLG's system. The offset follows the board's time zone, including daylight
# saving (sudo timedatectl set-timezone America/New_York). To force a fixed
# offset instead, in seconds east of UTC:
#ZLG_UTC_OFFSET=-18000

# 1: keep everything local. Removes the cron jobs that upload to NEP's cloud
# (my_nsync -> php remote, nepviewer.com). Data collection, the local web
# pages (fed by gdata.sh -> lsync -> php proxy, all local) and the reports
# are unaffected.
ZLG_LOCAL_ONLY=0

# 1: ZLG's command-line PHP (the cron jobs' php proxy, php wea, ...) runs on
# Debian's PHP 8.4; 0: on ZLG's PHP 5.4 (zlg-chroot)
ZLG_PHP84_CLI=1

# Weather on the pages (zlg-weather replaces NEP's dead Yahoo one); 0 keeps
# NEP's wea. The source (the Weather page's switch sets these two):
# weewx, from a local weewx station, read every 10 minutes; or openmeteo.
# Unset: weewx when ZLG_WEATHER_URL is set. ZLG_WEATHER_URL is the zlg.json
# that the station's zlg-json report writes (README 7a).
ZLG_WEATHER=1
#ZLG_WEATHER_SOURCE=weewx
#ZLG_WEATHER_URL=http://weather.home.arpa/zlg.json
# Without a station: Open-Meteo, hourly, for the gateway's General settings
# (longitude/latitude), or for this location in decimal degrees:
#ZLG_WEATHER_LAT=
#ZLG_WEATHER_LON=

# 1: the board's hostname becomes "NEP-" and the last five characters of the
# gateway's serial number (/root/Gateway/sn), e.g. NEP-xxxxx; 0: keep it
ZLG_HOSTNAME=1

# The Advanced page (NEP's MI Setup) can write grid settings to the
# inverters only with ZLG_MI_WRITES=1 (and the settings password); reading
# them works either way.
ZLG_MI_WRITES=0
