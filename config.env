# Build configuration for the ZLG M6G2C-256LI Debian SD-card image.
# Every value can be overridden from the environment, e.g.
#   sudo IMAGE_SIZE_MB=4096 ./build.sh all
#
# Site-specific and secret settings (Wi-Fi credentials) go in local.env next
# to this file. It is read first, so its values win over the defaults below.
# The environment still wins over both.

_m6g2c_cfg_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=/dev/null
[ -f "$_m6g2c_cfg_dir/local.env" ] && source "$_m6g2c_cfg_dir/local.env"
unset _m6g2c_cfg_dir

# ---- Toolchain -------------------------------------------------------------
: "${CROSS_COMPILE:=arm-linux-gnueabihf-}"
: "${JOBS:=$(nproc)}"

# ---- Sources ---------------------------------------------------------------
# Mainline U-Boot (the board port in board-files/u-boot is written against 2024.01).
: "${UBOOT_GIT:=https://source.denx.de/u-boot/u-boot.git}"
: "${UBOOT_REF:=v2024.01}"

# Linux 6.12 LTS, the series Debian 13 ships. Any v6.12.y tag works; newer
# stable releases are drop-in. The kernel stage also handles the pre-6.5
# flat device-tree layout, so v6.1.y still builds (set ARCH_FORCE_MAX_ORDER=11
# in the fragment for it: the option's meaning changed in 6.4).
: "${KERNEL_GIT:=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git}"
: "${KERNEL_REF:=v6.12.115}"

# ---- Debian ----------------------------------------------------------------
# Debian 13 "trixie": security support to 2028-08, LTS to 2030-06.
# Releases from 12 "bookworm" on work (non-free-firmware component,
# "<suite>-security" layout, split systemd-resolved/-timesyncd packages).
: "${DEBIAN_SUITE:=trixie}"
: "${DEBIAN_MIRROR:=http://deb.debian.org/debian}"
: "${DEBIAN_SECURITY_MIRROR:=http://security.debian.org/debian-security}"
: "${DEBIAN_COMPONENTS:=main contrib non-free non-free-firmware}"
: "${DEBIAN_ARCH:=armhf}"

: "${HOSTNAME_TARGET:=m6g2c}"
: "${DEFAULT_USER:=debian}"
: "${DEFAULT_PASSWORD:=debian}"      # user is forced to change it at first login
: "${TIMEZONE:=Etc/UTC}"
: "${LOCALE:=en_US.UTF-8}"

# Wi-Fi (TP-Link TL-WN823N USB dongle). Leave WIFI_SSID empty for no
# network config; set the real values in local.env. Only the derived
# WPA2 key (PBKDF2 of passphrase + SSID) is written to the image.
: "${WIFI_SSID:=}"
: "${WIFI_PASSPHRASE:=}"
: "${WIFI_COUNTRY:=US}"              # regulatory domain (channels, power)

# Extra packages on top of the base set in scripts/03-rootfs.sh
: "${EXTRA_PACKAGES:=}"

# apt's daily timers (package-list refresh). Off: they cost RAM and SD-card
# writes and nothing installs updates by itself. 1 = on (pair with
# EXTRA_PACKAGES=unattended-upgrades for automatic security updates).
: "${APT_DAILY:=0}"

# ---- Board -----------------------------------------------------------------
: "${DTB_NAME:=imx6ul-zlg-m6g2c}"
: "${SERIAL_CONSOLE:=ttymxc0}"       # UART1
: "${SERIAL_BAUD:=115200}"

# Extra kernel command line options, e.g. "quiet": prints only warnings on
# the serial console. That saves 1-2 s of boot, because the whole boot log
# goes out at 115200 baud when the console driver starts. Leave it empty
# while bringing the board up. Do not add "earlycon": it prints the log
# synchronously from the first instruction, slowing the early boot that has
# to fit inside the watchdog window.
: "${KERNEL_CMDLINE_EXTRA:=}"

# Root shell without a password in systemd emergency/rescue mode, on the
# serial console only. Root is otherwise locked; with 0 a failed boot step
# leaves you with no shell at all.
: "${RESCUE_SHELL_NOPASSWD:=1}"

# External hardware watchdog: GPIO that drives its WDI input, as
# "<bank>:<pin>". The EPC-M6G2C device tree from ZLG has a CAT82x supervisor
# ("cat82x-gpio-wdt") on GPIO5_IO00 (pad SNVS_TAMPER0) with
# hw_margin_ms = 700. Set WDT_GPIO="" for a carrier without it; unfed, the
# board resets about 1.6 s after power-on. See README section 4a.
: "${WDT_GPIO:=5:0}"
: "${WDT_MARGIN_MS:=700}"            # Linux gpio-wdt pings every half of this

# ---- Image -----------------------------------------------------------------
: "${IMAGE_SIZE_MB:=2048}"           # grows to fill the card on first boot
: "${BOOT_PART_MB:=128}"
: "${DISK_ID:=0x4d364732}"           # MBR disk id ("M6G2"); PARTUUIDs are <id>-01/-02
: "${IMAGE_NAME:=m6g2c-debian-${DEBIAN_SUITE}-armhf.img}"

# ---- Paths -----------------------------------------------------------------
: "${TOP:=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
: "${WORK:=${TOP}/work}"
: "${OUT:=${TOP}/out}"
